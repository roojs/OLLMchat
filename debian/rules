#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# debian/local-gguf is written by the packaging switch scripts:
#   enabled  — ollmchat (requires libllama at build time)
#   disabled — ollmchat-remote-only (no local GGUF backend)
LOCAL_GGUF := $(shell grep -E '^(enabled|disabled)$$' debian/local-gguf 2>/dev/null || echo enabled)

# Optional. Set WEBKIT_WEBDRIVER=disabled to link stock webkitgtk-6.0.
# Package builds leave this empty and link libwebkitgtk-6.0-webdriver.
WEBKIT_OPT :=
ifneq ($(strip $(WEBKIT_WEBDRIVER)),)
WEBKIT_OPT := -Dwebkit_webdriver=$(WEBKIT_WEBDRIVER)
endif

%:
	dh $@

override_dh_auto_configure:
	meson setup build --prefix=/usr -Ddocs=false -Dexamples=true -Dtests=false -Dlocal_gguf=$(LOCAL_GGUF) $(WEBKIT_OPT)

override_dh_auto_build:
	ninja -C build

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp ninja -C build install

override_dh_auto_test:
	# Tests can be run here if needed

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info
