         libollamaweb1 (= ${binary:Version}),
         libochf1 (= ${binary:Version}),
         libocwebkit1 (= ${binary:Version}),
         libocbwrap1 (= ${binary:Version})
Recommends: bubblewrap,
            ollmchat-tools
Conflicts: ollmchat-remote-only
Description: OLLMchat - LLM chat application
 OLLMchat is a GTK chat application with LLM access, tool integration,
 and embeddable libraries for other applications.
 .
 This package contains the ollmchat application and the ollmfilesd
 file daemon. Shared libraries ship in separate packages (libocrpc1,
 libollmchat1, and so on). Development files are in the matching *-dev
 packages.
 .
 For remote backends only (no local GGUF), install ollmchat-remote-only
 instead.

