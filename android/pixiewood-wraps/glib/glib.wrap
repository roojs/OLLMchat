[wrap-git]
directory=glib
url=https://gitlab.gnome.org/GNOME/glib.git
push-url=ssh://git@ssh.gitlab.gnome.org:GNOME/glib.git
revision=2.84.0
depth=1
# hack.patch: GDK Android calls private g_set_user_dirs (gdkandroidruntime.c)
# to set XDG dirs after extracting assets. GLib 2.84.0 does not export it
# (no GLIB_AVAILABLE_IN_ALL). gtk-android-builder does not ship this patch.
# Long-term: GLib #3449 (Android glue in GLib, not a GDK extern).
diff_files=glib/hack.patch

[provide]
dependency_names=gthread-2.0, gobject-2.0, gmodule-no-export-2.0, gmodule-export-2.0, gmodule-2.0, glib-2.0, gio-2.0, gio-windows-2.0, gio-unix-2.0
program_names=glib-genmarshal, glib-mkenums, glib-compile-schemas, glib-compile-resources, gio-querymodules, gdbus-codegen
