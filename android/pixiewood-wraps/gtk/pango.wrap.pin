[wrap-git]
directory = pango
url = https://gitlab.gnome.org/GNOME/pango.git
push-url = ssh://git@ssh.gitlab.gnome.org:GNOME/pango.git
# GTK's wrap tracks main (nightly docs). Pin 1.58.2 to match GTK >= 1.58
# requirement after android-ime rebase; needs glib >= 2.88 (Android glib.wrap
# is 2.90.0). Not named *.wrap: install_pixiewood_extra_wraps copies gtk/*.wrap
# into subprojects/, and Meson then errors "Multiple wrap files provide pango".
revision = d360f14004e4a4824f2352f6e2722016f9a51dd6
depth = 1

[provide]
pango = libpango_dep
pangoft2 = libpangoft2_dep
pangoxft = libpangoxft_dep
pangowin32 = libpangowin32_dep
pangocairo = libpangocairo_dep
