+static void
+gtk_text_view_long_press_gesture_begin (GtkGesture       *gesture,
+                                        GdkEventSequence *sequence,
+                                        GtkTextView      *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GdkEvent *event;
+  GdkEventType etype = 0;
+  GdkDevice *device;
+  const char *src = "?";
+
+  gtk_gesture_get_point (gesture, sequence, &priv->long_press_x, &priv->long_press_y);
+  priv->long_press_t0 = g_get_monotonic_time ();
+
+  event = gtk_gesture_get_last_event (gesture, sequence);
+  if (event != NULL && gtk_event_treat_as_touch (event) && priv->touch)
+    {
+      GtkTextTouchContext tctx = { 0, };
+
+      tctx.on_text = TRUE;
+      tctx.has_selection =
+        gtk_text_buffer_get_selection_bounds (get_buffer (text_view), NULL, NULL);
+      tctx.in_selection = tctx.has_selection;
+      gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_DOWN,
+                             &tctx, NULL);
+    }
+  if (event != NULL)
+    {
+      etype = gdk_event_get_event_type (event);
+      device = gdk_event_get_device (event);
+      if (device != NULL)
+        src = gdk_device_get_name (device);
+    }
+  g_message ("CLIP: longpress TextView BEGIN etype=%d src=%s xy=%.1f,%.1f",
+             (int) etype, src, priv->long_press_x, priv->long_press_y);
+
+  /* Claim with the click/drag group so Android keeps the sequence (H1) and
+   * click still sees multipress (A25). */
+  gtk_gesture_set_state (gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+gtk_text_view_long_press_gesture_cancelled (GtkGestureLongPress *gesture,
+                                            GtkTextView         *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GdkEventSequence *sequence;
+  double x = priv->long_press_x;
+  double y = priv->long_press_y;
+  int dx, dy, ms;
+  const char *reason;
+
+  sequence = gtk_gesture_get_last_updated_sequence (GTK_GESTURE (gesture));
+  if (sequence != NULL)
+    gtk_gesture_get_point (GTK_GESTURE (gesture), sequence, &x, &y);
+
+  dx = (int) (x - priv->long_press_x);
+  dy = (int) (y - priv->long_press_y);
+  ms = priv->long_press_t0 != 0
+    ? (int) ((g_get_monotonic_time () - priv->long_press_t0) / 1000)
+    : -1;
+  reason = (ABS (dx) > 8 || ABS (dy) > 8) ? "moved" : "early-up";
+
+  g_message ("CLIP: longpress TextView CANCELLED reason=%s dx=%d dy=%d ms=%d",
+             reason, dx, dy, ms);
+  priv->long_press_t0 = 0;
+  if (priv->touch)
+    {
+      GtkTextTouchIntent intent = GTK_TEXT_TOUCH_INTENT_NONE;
+
+      gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED,
+                             NULL, &intent);
+      gtk_text_view_touch_apply_chrome (text_view, intent, NULL, 0, 0, NULL);
+
+      /* Hold abandoned by move: place caret at the finger (GtkText parity).
+       * Fast swipes often finish before further drag-updates, so without this
+       * A19/A31 never see caret-only (phone 2026-07-27 eager-select guard). */
+      if (g_strcmp0 (reason, "moved") == 0)
+        {
+          GtkTextIter iter;
+          GtkTextBuffer *buf = get_buffer (text_view);
+          GtkTextTouchContext tctx = { 0, };
+          int off;
+          gboolean inside = FALSE;
+
+          get_iter_from_gesture_full (text_view, GTK_GESTURE (gesture),
+                                      &iter, NULL, NULL, &inside);
+          tctx.on_text = inside;
+          tctx.has_selection =
+            gtk_text_buffer_get_selection_bounds (buf, NULL, NULL);
+          gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_MOVED,
+                                 &tctx, &intent);
+          off = gtk_text_iter_get_offset (&iter);
+          gtk_text_buffer_place_cursor (buf, &iter);
+          if (priv->touch_multipress_pending)
+            gtk_text_view_touch_multipress_cancel_commit (text_view);
+          g_message ("CLIP: TextView drag caret-only off=%d mode=%s",
+                     off,
+                     gtk_text_touch_mode_nick (
+                       gtk_text_touch_get_mode (priv->touch)));
+          gtk_text_view_touch_apply_chrome (text_view, intent,
+                                            &iter, x, y, NULL);
+        }
+    }
+  else if (priv->magnifier_popover)
+    {
+      gtk_widget_set_visible (priv->magnifier_popover, FALSE);
+    }
+}
+
+static void
+gtk_text_view_long_press_gesture_pressed (GtkGestureLongPress *gesture,
+                                          double               x,
+                                          double               y,
+                                          GtkTextView         *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GtkTextIter iter;
+  GdkRectangle hit;
+  int gx, gy;
+  int slack;
+  gboolean outside_glyphs;
+
+  gtk_text_view_selection_bubble_popup_unset (text_view, "long-press-begin");
+
+  if (!get_iter_from_gesture (text_view, GTK_GESTURE (gesture), &iter, &gx, &gy))
+    {
+      g_message ("CLIP: longpress TextView FAIL no-iter widget=(%.1f,%.1f)", x, y);
+      return;
+    }
+
+  /* Empty padding only: glyph under finger + slack (soft-wrap safe). */
+  {
+    GtkTextIter line_end = iter;
+    GdkRectangle end_rect;
+    int end_x, row_y0, row_y1;
+    gboolean stock_out, hit_out, hit_slack_out;
+
+    gtk_text_view_get_iter_location (text_view, &iter, &hit);
+    slack = MAX (hit.height, 16);
+    if (!gtk_text_iter_ends_line (&line_end))
+      gtk_text_iter_forward_to_line_end (&line_end);
+    gtk_text_view_get_iter_location (text_view, &line_end, &end_rect);
+    end_x = end_rect.x + end_rect.width;
+    row_y0 = end_rect.y;
+    row_y1 = end_rect.y + end_rect.height;
+
+    stock_out =
+      (gy < row_y0) || (gy > row_y1) || (gx > end_x);
+    hit_out =
+      (gy < hit.y) || (gy > hit.y + hit.height) ||
+      (gx > hit.x + hit.width);
+    hit_slack_out =
+      (gy < hit.y - slack) ||
+      (gy > hit.y + hit.height + slack) ||
+      (gx > hit.x + hit.width + slack);
+
+    g_message ("CLIP: longpress TextView CAND gx=%d gy=%d off=%d "
+               "end_x=%d row_y=%d..%d hit_x=%d hit_w=%d hit_y=%d..%d slack=%d "
+               "stock=%s hit=%s hit_slack=%s APPLY=hit_slack",
+               gx, gy, gtk_text_iter_get_offset (&iter),
+               end_x, row_y0, row_y1,
+               hit.x, hit.width, hit.y, hit.y + hit.height, slack,
+               stock_out ? "OUT" : "IN",
+               hit_out ? "OUT" : "IN",
+               hit_slack_out ? "OUT" : "IN");
+
+    outside_glyphs = hit_slack_out;
+  }
+
+  {
+    GtkTextTouchContext tctx = { 0, };
+    GtkTextTouchIntent intent = GTK_TEXT_TOUCH_INTENT_NONE;
+
+    tctx.on_text = !outside_glyphs;
+    tctx.has_selection =
+      gtk_text_buffer_get_selection_bounds (get_buffer (text_view), NULL, NULL);
+    /* ::pressed means hold stayed inside long-press slop — do not demote
+     * because drag saw a few pixels (A26 / GtkText A20 parity). */
+    tctx.moved = FALSE;
+
+    gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_DOWN,
+                           &tctx, NULL);
+    gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_LONG_PRESS,
+                           &tctx, &intent);
+
+    if (intent & GTK_TEXT_TOUCH_INTENT_DENY)
+      {
+        if (gtk_text_touch_get_mode (priv->touch) == GTK_TEXT_TOUCH_MODE_CARET_DRAG)
+          {
+            g_message ("CLIP: longpress TextView SKIP (caret-drag already) gx=%d gy=%d",
+                       gx, gy);
+          }
+        else
+          {
+            GtkTextIter line_end = iter;
+
+            if (!gtk_text_iter_ends_line (&line_end))
+              gtk_text_iter_forward_to_line_end (&line_end);
+
+            g_message ("CLIP: longpress TextView OUTSIDE-GLYPHS gx=%d gy=%d "
+                       "hit_x=%d hit_w=%d hit_y=%d..%d slack=%d off=%d → cursor-only",
+                       gx, gy, hit.x, hit.width, hit.y, hit.y + hit.height, slack,
+                       gtk_text_iter_get_offset (&iter));
+            gtk_text_buffer_place_cursor (get_buffer (text_view), &line_end);
+          }
+        gtk_text_view_touch_apply_chrome (text_view, intent, &iter, gx, gy, NULL);
+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+        return;
+      }
+
+    if (intent & GTK_TEXT_TOUCH_INTENT_SELECT_WORD)
+      {
+        GtkTextIter start, end;
+
+        g_message ("CLIP: longpress TextView SELECT gx=%d gy=%d off=%d "
+                   "hit_x=%d hit_w=%d",
+                   gx, gy, gtk_text_iter_get_offset (&iter), hit.x, hit.width);
+
+        gtk_text_view_touch_snap_iter_to_word (&iter);
+        extend_selection (text_view, SELECT_WORDS, &iter, &start, &end);
+        gtk_text_buffer_select_range (get_buffer (text_view), &start, &end);
+        /* Hold-select is not a multipress chain. Block GC triple→lines until
+         * caret/outside tap (A7). N-press triple upgrades still allowed. */
+        gtk_text_view_touch_multipress_cancel_commit (text_view);
+        priv->touch_block_triple_lines = TRUE;
+        priv->touch_press_count = 0;
+        priv->touch_last_press_time = 0;
+        /* GtkText parity: do not attach mouse selection-drag. Hold+drag
+         * extend uses touch SELECTING + drag update (A26); attaching the
+         * mouse machine made double-tap+swipe hide as selection-drag (A33). */
+        gtk_text_view_touch_apply_chrome (text_view, intent, &iter, gx, gy, NULL);
+      }
+
+    if (intent & GTK_TEXT_TOUCH_INTENT_CLAIM)
+      gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+  }
+}
