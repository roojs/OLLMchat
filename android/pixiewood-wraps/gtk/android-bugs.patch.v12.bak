+/* Finger-up after SELECTING: show pins + bar. Click-released often misses this
+ * on Android because long-press CLAIMed the sequence at BEGIN (H1). */
+static gboolean
+gtk_text_reveal_cursor_handle_cb (gpointer data)
+{
+  GtkText *self = data;
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  priv->handle_reveal_timeout_id = 0;
+  gtk_text_update_handles (self);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gtk_text_touch_finish_contact (GtkText    *self,
+                               const char *bubble_reason)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+  GtkTextTouchMode mode;
+  GtkTextTouchContext tctx = { 0, };
+  GtkTextTouchIntent intent = GTK_TEXT_TOUCH_INTENT_NONE;
+  gboolean c_vis, b_vis;
+
+  if (priv->touch == NULL)
+    return;
+
+  mode = gtk_text_touch_get_mode (priv->touch);
+  if (mode != GTK_TEXT_TOUCH_MODE_SELECTING &&
+      mode != GTK_TEXT_TOUCH_MODE_CARET_DRAG &&
+      mode != GTK_TEXT_TOUCH_MODE_PENDING)
+    return;
+
+  tctx.has_selection = priv->current_pos != priv->selection_bound;
+  tctx.in_selection = tctx.has_selection;
+  gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_UP,
+                         &tctx, &intent);
+  gtk_text_touch_apply_chrome (self, intent, 0, 0, bubble_reason);
+
+  c_vis = priv->text_handles[TEXT_HANDLE_CURSOR] &&
+          gtk_widget_get_visible (GTK_WIDGET (priv->text_handles[TEXT_HANDLE_CURSOR]));
+  b_vis = priv->text_handles[TEXT_HANDLE_SELECTION_BOUND] &&
+          gtk_widget_get_visible (GTK_WIDGET (priv->text_handles[TEXT_HANDLE_SELECTION_BOUND]));
+  if (priv->current_pos != priv->selection_bound)
+    {
+      g_message ("CLIP: handle GtkText pins-shown cursor=%d bound=%d mode=%s",
+                 c_vis ? 1 : 0, b_vis ? 1 : 0,
+                 gtk_text_touch_mode_nick (gtk_text_touch_get_mode (priv->touch)));
+    }
+}
+
+static void
+gtk_text_touch_apply_chrome (GtkText           *self,
+                             GtkTextTouchIntent intent,
+                             int                magnifier_x,
+                             int                magnifier_y,
+                             const char        *bubble_reason)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE)
+    gtk_text_selection_bubble_popup_unset (self, bubble_reason ? bubble_reason
+                                                                : "touch-policy");
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER &&
+      priv->magnifier_popover)
+    gtk_popover_popdown (GTK_POPOVER (priv->magnifier_popover));
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES)
+    {
+      priv->text_handles_enabled = TRUE;
+      gtk_text_update_handles (self);
+    }
+  else if (intent & GTK_TEXT_TOUCH_INTENT_HIDE_HANDLES)
+    {
+      gtk_text_update_handles (self);
+    }
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_SHOW_MAGNIFIER)
+    gtk_text_show_magnifier (self, magnifier_x, magnifier_y);
+
+  if ((intent & GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE) &&
+      priv->current_pos != priv->selection_bound)
+    {
+      if (priv->selection_bubble &&
+          gtk_widget_get_visible (priv->selection_bubble))
+        g_message ("CLIP: click GtkText tap-in-sel-keep (dead click)");
+      else
+        gtk_text_selection_bubble_popup_set (self,
+                                             bubble_reason ? bubble_reason
+                                                           : "touch-policy");
+    }
+}
