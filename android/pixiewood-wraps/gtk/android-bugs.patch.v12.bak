+static gboolean
+get_iter_from_gesture (GtkTextView *text_view,
+                       GtkGesture  *gesture,
+                       GtkTextIter *iter,
+                       int         *x,
+                       int         *y)
+{
+  return get_iter_from_gesture_full (text_view, gesture, iter, x, y, NULL);
+}
+
+/* Stock WORD extend selects inter-word spaces when the iter is not inside a
+ * word. Touch double-tap should select a real word — snap to the nearest. */
+static void
+gtk_text_view_touch_snap_iter_to_word (GtkTextIter *iter)
+{
+  GtkTextIter before, after, tmp;
+  int off;
+  int d_before = G_MAXINT;
+  int d_after = G_MAXINT;
+
+  if (gtk_text_iter_inside_word (iter) || gtk_text_iter_starts_word (iter))
+    return;
+
+  off = gtk_text_iter_get_offset (iter);
+  before = *iter;
+  if (gtk_text_iter_backward_visible_word_start (&before))
+    d_before = off - gtk_text_iter_get_offset (&before);
+
+  tmp = *iter;
+  if (gtk_text_iter_forward_visible_word_end (&tmp))
+    {
+      gtk_text_iter_backward_visible_word_start (&tmp);
+      after = tmp;
+      d_after = gtk_text_iter_get_offset (&after) - off;
+      if (d_after < 0)
+        d_after = G_MAXINT;
+    }
+
+  if (d_after == G_MAXINT && d_before == G_MAXINT)
+    return;
+
+  if (d_after <= d_before)
+    *iter = after;
+  else
+    *iter = before;
+}
+
+/* Decide word vs line once, ~800ms after the first tap of a rapid chain.
+ * No intermediate words→lines upgrade (confusing on phone). */
+static void
+gtk_text_view_touch_multipress_cancel_commit (GtkTextView *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+
+  g_clear_handle_id (&priv->touch_multipress_commit_timeout_id, g_source_remove);
+  priv->touch_multipress_pending = FALSE;
+  priv->touch_multipress_target = 0;
+  priv->touch_multipress_anchor_time = 0;
+}
+
+static void
+gtk_text_view_touch_multipress_commit (GtkTextView *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GtkTextIter iter, sel_start, sel_end;
+  GtkTextTouchContext tctx = { 0, };
+  SelectionGranularity gran;
+  guint target;
+
+  if (!priv->touch_multipress_pending)
+    return;
+
+  target = priv->touch_multipress_target;
+  priv->touch_multipress_pending = FALSE;
+  g_clear_handle_id (&priv->touch_multipress_commit_timeout_id, g_source_remove);
+  priv->touch_multipress_target = 0;
+  priv->touch_multipress_anchor_time = 0;
+
+  if (target < 2)
+    return;
+
+  gran = (target >= 3) ? SELECT_LINES : SELECT_WORDS;
+  gtk_text_buffer_get_iter_at_offset (get_buffer (text_view), &iter,
+                                      priv->touch_multipress_offset);
+  /* Stock WORD extend selects the spaces between words when the tap is not
+   * inside a word (phone 2026-08-08). Snap to the nearest word first. */
+  if (gran == SELECT_WORDS)
+    gtk_text_view_touch_snap_iter_to_word (&iter);
+  extend_selection (text_view, gran, &iter, &sel_start, &sel_end);
+  gtk_text_buffer_select_range (get_buffer (text_view), &sel_start, &sel_end);
+  priv->text_handles_enabled = TRUE;
+  gtk_text_view_update_handles (text_view);
+  gtk_text_view_selection_bubble_popup_set (text_view, "n-press-select");
+  if (priv->touch != NULL)
+    {
+      tctx.on_text = TRUE;
+      tctx.has_selection = TRUE;
+      tctx.in_selection = TRUE;
+      gtk_text_touch_handle (priv->touch,
+                             GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION,
+                             &tctx, NULL);
+    }
+  {
+    gboolean ws_only = FALSE;
+    GtkTextIter walk = sel_start;
+
+    if (gran == SELECT_WORDS &&
+        gtk_text_iter_compare (&sel_start, &sel_end) < 0)
+      {
+        ws_only = TRUE;
+        while (gtk_text_iter_compare (&walk, &sel_end) < 0)
+          {
+            if (!g_unichar_isspace (gtk_text_iter_get_char (&walk)))
+              {
+                ws_only = FALSE;
+                break;
+              }
+            gtk_text_iter_forward_char (&walk);
+          }
+      }
+    g_message ("CLIP: click TextView touch multipress-commit %s off=%d..%d ws_only=%d",
+               target >= 3 ? "lines" : "words",
+               gtk_text_iter_get_offset (&sel_start),
+               gtk_text_iter_get_offset (&sel_end),
+               ws_only ? 1 : 0);
+  }
+  if (target >= 3)
+    {
+      /* Line commit ends the chain. A7 still blocks triple on a hold
+       * highlight via tap-in-sel / case 3 — do not zero count on words
+       * when chain_started_in_sel or the 3rd tap stays dead (phone). */
+      priv->touch_press_count = 0;
+      priv->touch_last_press_time = 0;
+      priv->touch_block_triple_lines = FALSE;
+      if (priv->click_gesture != NULL)
+        gtk_event_controller_reset (GTK_EVENT_CONTROLLER (priv->click_gesture));
+    }
+  else
+    {
+      /* Keep count at 2 so a rapid 3rd tap upgrades to lines (A23/A42). */
+      priv->touch_press_count = 2;
+    }
+}
+
+/* Android GestureClick often cancels instead of releasing, so stock n_press
+ * stays 1 (A25/A35 phone lottery). Count from the previous press like GtkText.
+ * Rapid same-spot taps (~50–300ms) form a chain; decide word/line once after
+ * ~800ms from the first tap. Slower taps inside Android's ~1200ms window must
+ * not stack (A41). Double on an existing highlight may use GestureClick's
+ * n_press≥2 even when the emu gap is ~450ms (A49). */
+static int
+gtk_text_view_touch_effective_n_press (GtkTextView *text_view,
+                                       GdkEvent    *event,
+                                       int          n_press,
+                                       double       x,
+                                       double       y)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GtkSettings *settings;
+  guint double_click_time = 400;
+  guint double_click_distance = 5;
+  const guint fast_double_ms = 300;
+  gint64 now;
+  gint64 gap_us = 0;
+  int dist;
+  gboolean same_spot = FALSE;
+  gboolean has_sel = FALSE;
+
+  if (event == NULL || !gtk_event_treat_as_touch (event))
+    return n_press;
+
+  settings = gtk_widget_get_settings (GTK_WIDGET (text_view));
+  g_object_get (settings,
+                "gtk-double-click-time", &double_click_time,
+                "gtk-double-click-distance", &double_click_distance,
+                NULL);
+  now = g_get_monotonic_time ();
+  dist = MAX ((int) double_click_distance, 48);
+  if (priv->touch_last_press_time != 0 &&
+      ABS ((int) x - priv->touch_last_press_x) < dist &&
+      ABS ((int) y - priv->touch_last_press_y) < dist)
+    {
+      same_spot = TRUE;
+      gap_us = now - priv->touch_last_press_time;
+    }
+
+  has_sel = gtk_text_buffer_get_selection_bounds (get_buffer (text_view),
+                                                  NULL, NULL);
+
+  /* After a word commit we leave count=2; GC often reports n_press=1 on the
+   * 3rd tap (phone). Upgrade even when the gap is >300ms or tap lands on the
+   * new word highlight — A7 still blocks triple on hold-sel at case 3. */
+  if (priv->touch_press_count == 2 &&
+      same_spot &&
+      gap_us > 0 &&
+      gap_us < (gint64) double_click_time * 1000)
+    {
+      priv->touch_press_count = 3;
+      priv->touch_last_press_time = now;
+      priv->touch_last_press_x = (int) x;
+      priv->touch_last_press_y = (int) y;
+      if (n_press != 3)
+        g_message ("CLIP: click TextView touch n_press=%d → effective=3 (word-upgrade)",
+                   n_press);
+      return 3;
+    }
+
+  if (same_spot && gap_us < (gint64) fast_double_ms * 1000)
+    {
+      /* Own chain (handles GC cancel→n_press=1 and GC inflated n_press=3
+       * after a demoted cross-spot press). */
