+
+/* Place GTK cursor/selection at Unicode code-point indices (Editable mirror). */
+static jboolean
+_gtk_im_context_android_set_selection (JNIEnv *env, jobject this,
+                                       jint cursor_idx, jint anchor_idx)
+{
+  GTK_IM_CONTEXT_ANDROID_DECLARE_SELF_WITH_RET (this, FALSE)
+
+  if (!self->client_widget)
+    return FALSE;
+
+  self->ime_mutating_gtk++;
+
+  if (GTK_IS_TEXT_VIEW (self->client_widget))
+    {
+      GtkTextBuffer *buffer;
+      GtkTextIter cursor, anchor;
+      int len;
+
+      buffer = gtk_text_view_get_buffer (GTK_TEXT_VIEW (self->client_widget));
+      len = gtk_text_buffer_get_char_count (buffer);
+      cursor_idx = CLAMP (cursor_idx, 0, len);
+      anchor_idx = CLAMP (anchor_idx, 0, len);
+      gtk_text_buffer_get_iter_at_offset (buffer, &cursor, cursor_idx);
+      gtk_text_buffer_get_iter_at_offset (buffer, &anchor, anchor_idx);
+      if (cursor_idx == anchor_idx)
+        gtk_text_buffer_place_cursor (buffer, &cursor);
+      else
+        gtk_text_buffer_select_range (buffer, &cursor, &anchor);
+    }
+  else if (GTK_IS_EDITABLE (self->client_widget))
+    {
+      GtkEditable *editable = GTK_EDITABLE (self->client_widget);
+      const char *text = gtk_editable_get_text (editable);
+      int len = text ? (int) g_utf8_strlen (text, -1) : 0;
+
+      cursor_idx = CLAMP (cursor_idx, 0, len);
+      anchor_idx = CLAMP (anchor_idx, 0, len);
+      if (cursor_idx == anchor_idx)
+        gtk_editable_set_position (editable, cursor_idx);
+      else
+        gtk_editable_select_region (editable,
+                                    MIN (anchor_idx, cursor_idx),
+                                    MAX (anchor_idx, cursor_idx));
+    }
+  else
+    {
+      self->ime_mutating_gtk--;
+      return FALSE;
+    }
+
+  self->ime_mutating_gtk--;
+  return TRUE;
 }
 
