+static void
+gtk_text_long_press_gesture_begin (GtkGesture       *gesture,
+                                   GdkEventSequence *sequence,
+                                   GtkText          *self)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  gtk_gesture_get_point (gesture, sequence, &priv->long_press_x, &priv->long_press_y);
+  priv->long_press_t0 = g_get_monotonic_time ();
+  {
+    GdkEvent *ev = gtk_gesture_get_last_event (gesture, sequence);
+    g_message ("CLIP: longpress GtkText BEGIN xy=%.1f,%.1f etype=%d touch=%d",
+               priv->long_press_x, priv->long_press_y,
+               ev ? (int) gdk_event_get_event_type (ev) : -1,
+               ev && gtk_event_treat_as_touch (ev) ? 1 : 0);
+  }
+  if (priv->touch)
+    {
+      GtkTextTouchContext tctx = { 0, };
+
+      tctx.on_text = TRUE;
+      tctx.has_selection = priv->current_pos != priv->selection_bound;
+      tctx.in_selection = tctx.has_selection;
+      gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_DOWN,
+                             &tctx, NULL);
+    }
+
+  /* Claim immediately so Android does not drop an unclaimed sequence
+   * before the hold delay (H1: CANCELLED early-up in ~30ms without this). */
+  gtk_gesture_set_state (gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+static void
+gtk_text_long_press_gesture_cancelled (GtkGestureLongPress *gesture,
+                                       GtkText             *self)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+  GdkEventSequence *sequence;
+  double x = priv->long_press_x;
+  double y = priv->long_press_y;
+  int dx, dy, ms;
+  const char *reason;
+
+  sequence = gtk_gesture_get_last_updated_sequence (GTK_GESTURE (gesture));
+  if (sequence != NULL)
+    gtk_gesture_get_point (GTK_GESTURE (gesture), sequence, &x, &y);
+
+  dx = (int) (x - priv->long_press_x);
+  dy = (int) (y - priv->long_press_y);
+  ms = priv->long_press_t0 != 0
+    ? (int) ((g_get_monotonic_time () - priv->long_press_t0) / 1000)
+    : -1;
+  reason = (ABS (dx) > 8 || ABS (dy) > 8) ? "moved" : "early-up";
+
+  g_message ("CLIP: longpress GtkText CANCELLED reason=%s dx=%d dy=%d ms=%d",
+             reason, dx, dy, ms);
+  priv->long_press_t0 = 0;
+
+  /* Click ::released is often skipped on Android GtkText (sequence cancel).
+   * Defer word commit briefly so a rapid 3rd tap can still upgrade (A23);
+   * do not wait full double-click-time (A53). */
+  if (g_strcmp0 (reason, "early-up") == 0 &&
+      priv->touch_multipress_pending)
+    {
+      if (priv->select_lines)
+        gtk_text_touch_multipress_commit (self);
+      else
+        gtk_text_touch_multipress_schedule_commit (self);
+      return;
+    }
+
+  if (priv->touch)
+    {
+      GtkTextTouchIntent intent = GTK_TEXT_TOUCH_INTENT_NONE;
+      int layout_x, tmp_pos, tx;
+
+      /* If we already selected (SELECTING), finger-up often arrives as
+       * cancelled/end without click-released — finish so pins appear. */
+      if ((priv->touch != NULL &&
+       gtk_text_touch_get_mode (priv->touch) == GTK_TEXT_TOUCH_MODE_SELECTING))
+        {
+          gtk_text_touch_finish_contact (self, "long-press-end");
+          return;
+        }
+
+      gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED,
+                             NULL, &intent);
+      gtk_text_touch_apply_chrome (self, intent, 0, 0, NULL);
+
+      /* Hold abandoned by move: start caret follow immediately. Leave
+       * sequence ownership to the normal deny/group handoff — claiming drag
+       * here was killing further motion updates (A15 only got 1 caret-only). */
+      if (g_strcmp0 (reason, "moved") == 0)
+        {
+          GtkTextTouchContext tctx = { 0, };
+
+          gtk_text_get_layout_offsets (self, &tx, NULL);
+          layout_x = (int) x - tx;
+          tmp_pos = gtk_text_touch_pos_from_point (self, layout_x, (int) y);
+          tctx.on_text = TRUE;
+          tctx.has_selection = priv->current_pos != priv->selection_bound;
+          gtk_text_touch_handle (priv->touch, GTK_TEXT_TOUCH_EVENT_MOVED,
+                                 &tctx, &intent);
+          g_message ("CLIP: GtkText drag caret-only pos=%d (was %d..%d) mode=%s",
+                     tmp_pos,
+                     MIN (priv->current_pos, priv->selection_bound),
+                     MAX (priv->current_pos, priv->selection_bound),
+                     gtk_text_touch_mode_nick (gtk_text_touch_get_mode (priv->touch)));
+          gtk_text_set_positions (self, tmp_pos, tmp_pos);
+          gtk_text_touch_apply_chrome (self, intent,
+                                       layout_x - priv->scroll_offset, (int) y,
+                                       NULL);
+        }
+    }
+  else if (priv->magnifier_popover)
+    {
+      gtk_popover_popdown (GTK_POPOVER (priv->magnifier_popover));
+    }
+}
+
+static void
+gtk_text_long_press_gesture_end (GtkGesture       *gesture,
+                                 GdkEventSequence *sequence,
+                                 GtkText          *self)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  /* After a successful hold, Android often delivers end here while click is
+   * starved by the BEGIN claim — still show pins. */
+  if ((priv->touch != NULL &&
+       gtk_text_touch_get_mode (priv->touch) == GTK_TEXT_TOUCH_MODE_SELECTING))
+    gtk_text_touch_finish_contact (self, "long-press-end");
+}
