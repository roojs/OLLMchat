-/* Relative to pointing_to x/y */
+static void
+handle_restore_suppressed_targets (GtkTextHandle *handle)
+{
+  GSList *l;
+
+  for (l = handle->suppress_can_target; l != NULL; l = l->next)
+    {
+      GtkWidget *w = l->data;
+
+      if (GTK_IS_WIDGET (w))
+        gtk_widget_set_can_target (w, TRUE);
+    }
+  g_clear_slist (&handle->suppress_can_target, NULL);
