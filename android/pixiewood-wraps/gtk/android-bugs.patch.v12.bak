+static void
+gtk_text_view_touch_apply_chrome (GtkTextView       *text_view,
+                                  GtkTextTouchIntent intent,
+                                  GtkTextIter       *magnifier_iter,
+                                  int                magnifier_x,
+                                  int                magnifier_y,
+                                  const char        *bubble_reason)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE)
+    gtk_text_view_selection_bubble_popup_unset (text_view,
+                                                bubble_reason ? bubble_reason
+                                                              : "touch-policy");
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER &&
+      priv->magnifier_popover)
+    gtk_popover_popdown (GTK_POPOVER (priv->magnifier_popover));
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES)
+    {
+      priv->text_handles_enabled = TRUE;
+      gtk_text_view_update_handles (text_view);
+    }
+  else if (intent & GTK_TEXT_TOUCH_INTENT_HIDE_HANDLES)
+    {
+      gtk_text_view_update_handles (text_view);
+    }
+
+  if ((intent & GTK_TEXT_TOUCH_INTENT_SHOW_MAGNIFIER) &&
+      magnifier_iter != NULL)
+    gtk_text_view_show_magnifier (text_view, magnifier_iter,
+                                  magnifier_x, magnifier_y);
+
+  if (intent & GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE)
+    {
+      if (gtk_text_buffer_get_selection_bounds (get_buffer (text_view), NULL, NULL))
+        {
+          if (priv->selection_bubble &&
+              gtk_widget_get_visible (priv->selection_bubble))
+            g_message ("CLIP: click TextView tap-in-sel-keep (dead click)");
+          else
+            gtk_text_view_selection_bubble_popup_set (text_view,
+                                                      bubble_reason ? bubble_reason
+                                                                    : "touch-policy");
+        }
+    }
+}
