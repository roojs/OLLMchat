+			int cur = Math.max(0, Math.min(utf16Cursor, neu.length()));
+			int anc = Math.max(0, Math.min(utf16Anchor < 0 ? cur : utf16Anchor, neu.length()));
+			int cursorCp = neu.isEmpty() ? 0 : neu.codePointCount(0, cur);
+			int anchorCp = neu.isEmpty() ? 0 : neu.codePointCount(0, anc);
+			setSelection(cursorCp, anchorCp);
+		});
+	}
