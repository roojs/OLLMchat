+static void
+gtk_im_context_android_notify_editable_from_gtk (GtkIMContextAndroid *self)
+{
+  JNIEnv *env;
+
+  if (self->ime_mutating_gtk > 0 || !self->focused || !self->context)
+    return;
+
+  env = gdk_android_get_env ();
+  (*env)->CallVoidMethod (env, self->context,
+                          gtk_im_context_android_java_cache.notify_gtk_text_changed);
+}
+
+static void
+gtk_im_context_android_on_text_buffer_changed (GtkTextBuffer        *buffer,
+                                               GtkIMContextAndroid  *self)
+{
+  gtk_im_context_android_notify_editable_from_gtk (self);
+}
+
+static void
+gtk_im_context_android_on_text_buffer_mark_set (GtkTextBuffer       *buffer,
+                                                const GtkTextIter   *location,
+                                                GtkTextMark         *mark,
+                                                GtkIMContextAndroid *self)
+{
+  const char *name = gtk_text_mark_get_name (mark);
+
+  /* Only insert / selection-bound affect what Gboard should see. */
+  if (name == NULL)
+    return;
+  if (strcmp (name, "insert") != 0 && strcmp (name, "selection_bound") != 0)
+    return;
+
+  gtk_im_context_android_notify_editable_from_gtk (self);
+}
+
+static void
+gtk_im_context_android_on_entry_inserted (GtkEntryBuffer      *buffer,
+                                          guint                position,
+                                          const char          *chars,
+                                          guint                n_chars,
+                                          GtkIMContextAndroid *self)
+{
+  gtk_im_context_android_notify_editable_from_gtk (self);
+}
+
+static void
+gtk_im_context_android_on_entry_deleted (GtkEntryBuffer      *buffer,
+                                         guint                position,
+                                         guint                n_chars,
+                                         GtkIMContextAndroid *self)
+{
+  gtk_im_context_android_notify_editable_from_gtk (self);
+}
+
+static void
+gtk_im_context_android_on_text_cursor_notify (GObject             *object,
+                                              GParamSpec          *pspec,
+                                              GtkIMContextAndroid *self)
+{
+  gtk_im_context_android_notify_editable_from_gtk (self);
+}
+
+static void
+gtk_im_context_android_detach_buffer (GtkIMContextAndroid *self)
+{
+  if (self->watched_buffer == NULL && self->watched_cursor_id == 0)
+    return;
+
+  if (self->watched_buffer)
+    {
+      g_clear_signal_handler (&self->watched_changed_id, self->watched_buffer);
+      g_clear_signal_handler (&self->watched_mark_set_id, self->watched_buffer);
+      g_clear_signal_handler (&self->watched_inserted_id, self->watched_buffer);
+      g_clear_signal_handler (&self->watched_deleted_id, self->watched_buffer);
+    }
+
+  if (self->client_widget)
+    {
+      g_clear_signal_handler (&self->watched_cursor_id, self->client_widget);
+      g_clear_signal_handler (&self->watched_selection_id, self->client_widget);
+    }
+
+  g_clear_object (&self->watched_buffer);
+}
+
+static void
+gtk_im_context_android_attach_buffer (GtkIMContextAndroid *self,
+                                      GtkWidget           *widget)
+{
+  gtk_im_context_android_detach_buffer (self);
+
+  if (widget == NULL)
+    return;
+
+  if (GTK_IS_TEXT_VIEW (widget))
+    {
+      GtkTextBuffer *buffer = gtk_text_view_get_buffer (GTK_TEXT_VIEW (widget));
+
+      self->watched_buffer = G_OBJECT (g_object_ref (buffer));
+      self->watched_changed_id =
+          g_signal_connect (buffer, "changed",
+                            G_CALLBACK (gtk_im_context_android_on_text_buffer_changed),
+                            self);
+      self->watched_mark_set_id =
+          g_signal_connect (buffer, "mark-set",
+                            G_CALLBACK (gtk_im_context_android_on_text_buffer_mark_set),
+                            self);
+    }
+  else if (GTK_IS_TEXT (widget) || GTK_IS_ENTRY (widget))
+    {
+      GtkEntryBuffer *buffer;
+
+      if (GTK_IS_TEXT (widget))
+        buffer = gtk_text_get_buffer (GTK_TEXT (widget));
+      else
+        buffer = gtk_entry_get_buffer (GTK_ENTRY (widget));
+
+      self->watched_buffer = G_OBJECT (g_object_ref (buffer));
+      self->watched_inserted_id =
+          g_signal_connect (buffer, "inserted-text",
+                            G_CALLBACK (gtk_im_context_android_on_entry_inserted),
+                            self);
+      self->watched_deleted_id =
+          g_signal_connect (buffer, "deleted-text",
+                            G_CALLBACK (gtk_im_context_android_on_entry_deleted),
+                            self);
+
+      /* EntryBuffer has no cursor signal; GtkText exposes cursor/selection. */
+      if (GTK_IS_TEXT (widget))
+        {
+          self->watched_cursor_id =
+              g_signal_connect (widget, "notify::cursor-position",
+                                G_CALLBACK (gtk_im_context_android_on_text_cursor_notify),
+                                self);
+          self->watched_selection_id =
+              g_signal_connect (widget, "notify::selection-bound",
+                                G_CALLBACK (gtk_im_context_android_on_text_cursor_notify),
+                                self);
+        }
+    }
+}
+
 static GdkAndroidSurface *
 gtk_im_context_android_get_surface (GtkIMContextAndroid *self)
 {
@@ -378,11 +665,13 @@ gtk_im_context_android_set_client_widget (GtkIMContext *context,
 
   GTK_DEBUG (MODULES, "gtk_im_context_android_set_client_widget: %p", widget);
 
+  gtk_im_context_android_detach_buffer (self);
   g_clear_weak_pointer (&self->client_widget);
   self->client_widget = widget;
   if (widget != NULL)
     {
       g_object_add_weak_pointer ((GObject *)self->client_widget, (gpointer *)&self->client_widget);
+      gtk_im_context_android_attach_buffer (self, widget);
       gtk_im_context_android_update_ime_keyboard (self);
     }
 
