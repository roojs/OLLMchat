@@ -596,29 +801,566 @@ handle_do_toplevel_transform (GtkTextHandle *handle, gfloat *tx, gfloat *ty)
   *ty = p.y;
 }
 
+static void
+handle_event_to_tip_space (GtkTextHandle *handle,
+                           double         x,
+                           double         y,
+                           graphene_point_t *p)
+{
+  GtkWidget *parent = gtk_widget_get_parent (GTK_WIDGET (handle));
+  graphene_point_t parent_pt;
+
+  if (parent == NULL || handle->controller_widget == NULL)
+    {
+      graphene_point_init (p, x, y);
+      return;
+    }
+
+  if (handle->controller_widget == parent)
+    {
+      parent_pt.x = x;
+      parent_pt.y = y;
+    }
+  else if (!gtk_widget_compute_point (handle->controller_widget, parent,
+                                      &GRAPHENE_POINT_INIT (x, y),
+                                      &parent_pt))
+    {
+      graphene_point_init (p, x, y);
+      handle_do_toplevel_transform (handle, &p->x, &p->y);
+      return;
+    }
+
+  p->x = parent_pt.x - handle->pointing_to.x;
+  p->y = parent_pt.y - handle->pointing_to.y - handle->pointing_to.height;
+}
+
+static gboolean
+handle_tip_in_extents (GtkTextHandle *handle,
+                       double         tip_x,
+                       double         tip_y)
+{
+  GtkBorder input_extents;
+
+  handle_get_input_extents (handle, &input_extents);
+  return tip_x >= input_extents.left && tip_x < input_extents.right &&
+         tip_y >= input_extents.top && tip_y < input_extents.bottom;
+}
+
+/* Pin-hit matrix: selection pin may claim this tip (before nearest/deny). */
+static gboolean
+handle_selection_tip_raw_ok (GtkTextHandle *handle,
+                             double         tip_x,
+                             double         tip_y)
+{
+  GtkWidget *widget = GTK_WIDGET (handle);
+  gboolean is_start_pin;
+  gboolean stem_beside;
+  /* Letter-row beside-stem (A44). Cap keeps far letter taps MISS (A48).
+   * END inward beside-stem needs ~95 (A44 tip≈-86); outward capped 48. */
+  const double stem_x_min = 40.0;
+  const double stem_x_max = 64.0;
+  const double stem_x_max_end_in = 95.0;
+  const double stem_x_max_end_out = 48.0;
+  const double stem_min_y = -20.0;
+
+  is_start_pin =
+    (handle->role == GTK_TEXT_HANDLE_ROLE_SELECTION_START &&
+     gtk_widget_get_direction (widget) != GTK_TEXT_DIR_RTL) ||
+    (handle->role == GTK_TEXT_HANDLE_ROLE_SELECTION_END &&
+     gtk_widget_get_direction (widget) == GTK_TEXT_DIR_RTL);
+
+  /* Letter-row beside stem: START inward (positive tip_x); END needs both
+   * inward and outward beside-stem (A44 tip≈+44 into glyphs). Cap at
+   * stem_x_max so A48 far taps (tip≈75+) stay MISS. */
+  if (is_start_pin)
+    stem_beside = (tip_x >= stem_x_min && tip_x <= stem_x_max &&
+                   tip_y >= stem_min_y && tip_y < 10.0);
+  else
+    stem_beside = (((tip_x <= -stem_x_min && tip_x >= -stem_x_max_end_in) ||
+                    (tip_x >= stem_x_min && tip_x <= stem_x_max_end_out)) &&
+                   tip_y >= stem_min_y && tip_y < 10.0);
+
+  if (handle_tip_in_extents (handle, tip_x, tip_y))
+    {
+      if (tip_y < 10.0)
+        {
+          /* Letter row: tight on-stem + stem_beside inward. Also allow the
+           * pin-row outward near-stem band (tip_x 10–40 for END) — mid-line
+           * aim at the right pin often lands tip_x≈10–35 tip_y≈-5 and missed
+           * while pin-row would HIT (Alan 2026-08-31). Do NOT widen inward
+           * on-stem or mid-letters steals the pin (matrix P-mid-letters). */
+          if (tip_x >= -12.0 && tip_x <= 8.0 && tip_y >= stem_min_y)
+            return TRUE;
+          if (is_start_pin)
+            {
+              if (tip_x <= -10.0 && tip_x >= -40.0 && tip_y >= stem_min_y)
+                return TRUE;
+            }
+          else
+            {
+              if (tip_x >= 10.0 && tip_x <= 40.0 && tip_y >= stem_min_y)
+                return TRUE;
+            }
+          if (stem_beside)
+            return TRUE;
+          return FALSE;
+        }
+      /* Pin row: finger-sized box (phone 2026-08-27 — ≤24 was too tight). */
+      if (is_start_pin)
+        {
+          if (tip_x >= -20.0 && tip_x <= 16.0 && tip_y <= 56.0)
+            return TRUE;
+          if (tip_x <= -10.0 && tip_x >= -40.0 && tip_y <= 56.0)
+            return TRUE;
+          return FALSE;
+        }
+      else
+        {
+          if (tip_x >= -32.0 && tip_x <= 12.0 && tip_y <= 56.0)
+            return TRUE;
+          if (tip_x >= 10.0 && tip_x <= 40.0 && tip_y <= 56.0)
+            return TRUE;
