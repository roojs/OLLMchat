+  if (saved_context)
+    {
+      gdk_gl_context_make_current (saved_context);
+      g_object_unref (saved_context);
+    }
+
   return op->next;
 }
 
diff --git a/gtk/gtkgestureclick.c b/gtk/gtkgestureclick.c
index c2abb9d052..821a27ea13 100644
--- a/gtk/gtkgestureclick.c
+++ b/gtk/gtkgestureclick.c
@@ -239,13 +239,36 @@ gtk_gesture_click_update (GtkGesture       *gesture,
                           GdkEventSequence *sequence)
 {
   GtkGestureClick *click;
+  GtkGestureClickPrivate *priv;
   GdkEventSequence *current;
   double x, y;
 
   click = GTK_GESTURE_CLICK (gesture);
+  priv = gtk_gesture_click_get_instance_private (click);
   current = gtk_gesture_single_get_current_sequence (GTK_GESTURE_SINGLE (gesture));
   gtk_gesture_get_point (gesture, current, &x, &y);
 
+  /* Touch taps jitter more than mouse clicks. Stock dnd threshold (~8px)
+   * was wiping n_presses mid-tap on Android GtkText so every tap stayed
+   * n_press=1 (A22/A23). Match long-press Android slop. */
+  if (priv->current_device &&
+      gdk_device_get_source (priv->current_device) == GDK_SOURCE_TOUCHSCREEN)
+    {
+      GtkWidget *widget;
+      GtkSettings *settings;
+      int threshold = 8;
+
+      widget = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+      settings = gtk_widget_get_settings (widget);
+      g_object_get (settings, "gtk-dnd-drag-threshold", &threshold, NULL);
+      threshold = MAX (threshold * 4, 40);
+
+      if (ABS (priv->initial_press_x - x) >= threshold ||
+          ABS (priv->initial_press_y - y) >= threshold)
+        _gtk_gesture_click_stop (click);
+      return;
+    }
+
   if (!_gtk_gesture_click_check_within_threshold (click, "gtk-dnd-drag-threshold", x, y))
     _gtk_gesture_click_stop (click);
 }
