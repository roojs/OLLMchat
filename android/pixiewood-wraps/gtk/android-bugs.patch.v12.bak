+static int
+gtk_text_touch_effective_n_press (GtkText   *self,
+                                  GdkEvent  *event,
+                                  int        n_press,
+                                  int        layout_x)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+  GtkSettings *settings;
+  guint double_click_time = 400;
+  guint double_click_distance = 5;
+  const guint fast_double_ms = 300;
+  gint64 now;
+  gint64 gap_us = 0;
+  gboolean same_spot = FALSE;
+
+  if (event == NULL || !gtk_event_treat_as_touch (event))
+    return n_press;
+
+  /* GtkGestureClick on Android GtkText often cancels instead of releasing,
+   * so n_press stays 1. Count from the previous press (A22/A23). Only rapid
+   * same-spot taps (~300ms) chain — slower taps inside Android's ~1200ms
+   * window must not stack (A9/A41 parity with TextView). */
+  settings = gtk_widget_get_settings (GTK_WIDGET (self));
+  g_object_get (settings,
+                "gtk-double-click-time", &double_click_time,
+                "gtk-double-click-distance", &double_click_distance,
+                NULL);
+  now = g_get_monotonic_time ();
+  if (priv->touch_last_press_time != 0 &&
+      ABS (layout_x - priv->touch_last_press_x) < (int) MAX (double_click_distance, 48))
+    {
+      same_spot = TRUE;
+      gap_us = now - priv->touch_last_press_time;
+    }
+
+  if (priv->touch_press_count == 2 &&
+      same_spot &&
+      gap_us > 0 &&
+      gap_us < (gint64) double_click_time * 1000)
+    {
+      priv->touch_press_count = 3;
+      priv->touch_last_press_time = now;
+      priv->touch_last_press_x = layout_x;
+      return 3;
+    }
+
+  if (same_spot && gap_us < (gint64) fast_double_ms * 1000)
+    {
+      priv->touch_press_count++;
+      /* Parity with TextView: after a demoted slow 2nd, a fast GC n_press=3
+       * must still reach lines (count++ alone stays at words). */
+      if (n_press >= 3)
+        priv->touch_press_count =
+          MAX (priv->touch_press_count, MIN ((guint) n_press, 3u));
+    }
+  else
+    priv->touch_press_count = 1;
+
+  if (priv->touch_press_count > 3)
+    priv->touch_press_count = 1;
+
+  priv->touch_last_press_time = now;
+  priv->touch_last_press_x = layout_x;
+
+  return (int) priv->touch_press_count;
+}
+
+static void
+gtk_text_touch_multipress_commit (GtkText *self)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  if (!priv->touch_multipress_pending)
+    return;
+
+  priv->touch_multipress_pending = FALSE;
+  g_clear_handle_id (&priv->touch_multipress_commit_timeout_id, g_source_remove);
+
+  gboolean did_lines = FALSE;
+
+  if (priv->select_words)
+    {
+      gtk_text_select_word (self);
+      g_message ("CLIP: click GtkText multipress-commit words");
+      priv->select_words = FALSE;
+    }
+  else if (priv->select_lines)
+    {
+      gtk_text_select_line (self);
+      g_message ("CLIP: click GtkText multipress-commit lines");
+      priv->select_lines = FALSE;
+      did_lines = TRUE;
+    }
+
+  priv->text_handles_enabled = TRUE;
+  gtk_text_update_handles (self);
+  if (priv->current_pos != priv->selection_bound)
+    gtk_text_selection_bubble_popup_set (self, "n-press-select");
+
+  if (did_lines)
+    {
+      priv->touch_press_count = 0;
+      priv->touch_last_press_time = 0;
+      if (priv->click_gesture != NULL)
+        gtk_event_controller_reset (GTK_EVENT_CONTROLLER (priv->click_gesture));
+    }
+  else
+    priv->touch_press_count = 2;
+}
+
+static gboolean
+gtk_text_touch_multipress_commit_timeout_cb (gpointer data)
+{
+  GtkText *self = data;
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  priv->touch_multipress_commit_timeout_id = 0;
+  gtk_text_touch_multipress_commit (self);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gtk_text_touch_multipress_schedule_commit (GtkText *self)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+  /* Short defer so a rapid 3rd tap can upgrade to lines (A23). Full
+   * gtk-double-click-time (~400–1200ms) felt dead (A53); immediate commit
+   * on release let pins steal the 3rd tap (phone 2026-08-27). */
+  const guint upgrade_ms = 280;
+
+  if (!priv->touch_multipress_pending)
+    return;
+
+  g_clear_handle_id (&priv->touch_multipress_commit_timeout_id, g_source_remove);
+  priv->touch_multipress_commit_timeout_id =
+    g_timeout_add (upgrade_ms,
+                   gtk_text_touch_multipress_commit_timeout_cb, self);
+}
+
+static int
+gtk_text_touch_pos_from_point (GtkText *self,
+                               int      layout_x,
+                               int      widget_y)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+  PangoLayout *layout;
+  int text_width = 0;
+  int height = gtk_widget_get_height (GTK_WIDGET (self));
+
+  layout = gtk_text_ensure_layout (self, TRUE);
+  pango_layout_get_pixel_size (layout, &text_width, NULL);
+
+  /* Single-line field: Y must not map to start/end. When the finger leaves
+   * the widget vertically, Android often reports a bogus X (→ pos=0). Keep
+   * the last in-bounds layout X instead (A29 / phone 2026-07-27). */
+  if (widget_y < 0 || (height > 0 && widget_y >= height))
+    layout_x = priv->touch_last_layout_x;
+  else
+    priv->touch_last_layout_x = layout_x;
+
+  if (layout_x < 0)
+    layout_x = 0;
+  if (text_width > 0 && layout_x > text_width)
+    layout_x = text_width;
+
+  return gtk_text_find_position (self, layout_x);
+}
