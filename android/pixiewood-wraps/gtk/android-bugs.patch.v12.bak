+      /* Still emit stem CLIP so accept matrix can calibrate after select
+       * even when the caret rect did not move. */
+      if (handle->role == GTK_TEXT_HANDLE_ROLE_SELECTION_START ||
+          handle->role == GTK_TEXT_HANDLE_ROLE_SELECTION_END)
+        g_message ("CLIP: handle stem role=%d parent=%.0f,%.0f",
+                   (int) handle->role,
+                   (double) rect->x + rect->width / 2.0,
+                   (double) rect->y + rect->height);
+      return;
+    }
 
   handle->pointing_to = *rect;
   handle->has_point = TRUE;
 
+  if (handle->role == GTK_TEXT_HANDLE_ROLE_SELECTION_START ||
+      handle->role == GTK_TEXT_HANDLE_ROLE_SELECTION_END)
+    {
+      /* Pin-hit matrix calibrates probes from these parent tip origins. */
+      g_message ("CLIP: handle stem role=%d parent=%.0f,%.0f",
+                 (int) handle->role,
+                 (double) rect->x + rect->width / 2.0,
+                 (double) rect->y + rect->height);
+    }
+
   if (gtk_widget_is_visible (GTK_WIDGET (handle)))
-    gtk_text_handle_present_surface (handle);
+    {
+      gtk_text_handle_present_surface (handle);
+      /* Map often runs before the first set_position (visible set first in
+       * TextView), so the drag gesture was never installed — pins painted but
+       * ignored touches (LP-1 §F). */
+      if (handle->controller_widget == NULL &&
+          gtk_widget_get_mapped (GTK_WIDGET (handle)))
+        text_handle_set_up_gesture (handle);
+    }
 }
 
 gboolean
diff --git a/gtk/gtktexttouch.c b/gtk/gtktexttouch.c
new file mode 100644
index 0000000000..21ae925510
--- /dev/null
+++ b/gtk/gtktexttouch.c
@@ -0,0 +1,420 @@
+/* GTK - The GIMP Toolkit
+ * Copyright © 2026 Knowles / LP-1 touch policy
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ *
+ * Per-widget touch mode machine for GtkText + GtkTextView.
+ * Gestures report facts; widgets apply returned intents. Mouse stays on
+ * classic widget paths (hybrid = per sequence).
+ */
+
+#include "config.h"
+
+#include "gtktexttouchprivate.h"
+
+#include "gtkprivate.h"
+
+struct _GtkTextTouch
+{
+  GtkTextTouchMode mode;
+};
+
+GtkTextTouch *
+gtk_text_touch_new (void)
+{
+  return g_new0 (GtkTextTouch, 1);
+}
+
+void
+gtk_text_touch_free (GtkTextTouch *self)
+{
+  g_free (self);
+}
+
+GtkTextTouchMode
+gtk_text_touch_get_mode (GtkTextTouch *self)
+{
+  g_return_val_if_fail (self != NULL, GTK_TEXT_TOUCH_MODE_IDLE);
+  return self->mode;
+}
+
+const char *
+gtk_text_touch_mode_nick (GtkTextTouchMode mode)
+{
+  switch (mode)
+    {
+    case GTK_TEXT_TOUCH_MODE_IDLE:        return "idle";
+    case GTK_TEXT_TOUCH_MODE_PENDING:     return "pending";
+    case GTK_TEXT_TOUCH_MODE_CARET_DRAG:  return "caret-drag";
+    case GTK_TEXT_TOUCH_MODE_SELECTING:   return "selecting";
+    case GTK_TEXT_TOUCH_MODE_SELECTED:    return "selected";
+    case GTK_TEXT_TOUCH_MODE_PIN_CARET:   return "pin-caret";
+    case GTK_TEXT_TOUCH_MODE_PIN_SELECT:  return "pin-select";
+    default:                              return "?";
+    }
+}
+
+const char *
+gtk_text_touch_event_nick (GtkTextTouchEvent event)
+{
+  switch (event)
+    {
+    case GTK_TEXT_TOUCH_EVENT_DOWN:              return "down";
+    case GTK_TEXT_TOUCH_EVENT_MOVED:             return "moved";
+    case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:        return "long-press";
+    case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:    return "hold-cancelled";
+    case GTK_TEXT_TOUCH_EVENT_UP:                return "up";
+    case GTK_TEXT_TOUCH_EVENT_CANCEL:            return "cancel";
+    case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:       return "pin-grabbed";
+    case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:       return "pin-dragged";
+    case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:      return "pin-released";
+    case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:  return "tap-in-sel";
+    case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:       return "tap-outside";
+    default:                                     return "?";
+    }
+}
+
+static void
+set_mode (GtkTextTouch     *self,
+          GtkTextTouchMode  mode)
+{
+  if (self->mode == mode)
+    return;
+
+  GTK_DEBUG (TEXT, "GtkTextTouch %s → %s",
+             gtk_text_touch_mode_nick (self->mode),
+             gtk_text_touch_mode_nick (mode));
+  self->mode = mode;
+}
+
+static GtkTextTouchIntent
+handle_pin_grabbed (GtkTextTouch         *self,
+                    GtkTextTouchPinKind   pin)
+{
+  if (pin == GTK_TEXT_TOUCH_PIN_CURSOR)
+    {
+      set_mode (self, GTK_TEXT_TOUCH_MODE_PIN_CARET);
+      return GTK_TEXT_TOUCH_INTENT_CLAIM |
+             GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+    }
+  if (pin != GTK_TEXT_TOUCH_PIN_NONE)
+    {
+      set_mode (self, GTK_TEXT_TOUCH_MODE_PIN_SELECT);
+      return GTK_TEXT_TOUCH_INTENT_CLAIM |
+             GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+    }
+  return GTK_TEXT_TOUCH_INTENT_NONE;
+}
+
+gboolean
+gtk_text_touch_handle (GtkTextTouch              *self,
+                       GtkTextTouchEvent          event,
+                       const GtkTextTouchContext *ctx,
+                       GtkTextTouchIntent        *intent_out)
+{
+  GtkTextTouchIntent intent = GTK_TEXT_TOUCH_INTENT_NONE;
+  GtkTextTouchContext empty = { 0, };
+  gboolean on_text;
+  gboolean in_selection;
+  gboolean has_selection;
+  GtkTextTouchPinKind pin;
+
+  g_return_val_if_fail (self != NULL, FALSE);
+
+  if (ctx == NULL)
+    ctx = &empty;
+
+  on_text = ctx->on_text;
+  in_selection = ctx->in_selection;
+  has_selection = ctx->has_selection;
+  pin = ctx->pin;
+
+  if (intent_out)
+    *intent_out = GTK_TEXT_TOUCH_INTENT_NONE;
+
+  GTK_DEBUG (TEXT, "GtkTextTouch handle mode=%s event=%s on_text=%d in_sel=%d",
+             gtk_text_touch_mode_nick (self->mode),
+             gtk_text_touch_event_nick (event),
+             on_text, in_selection);
+
+  switch (self->mode)
+    {
+    case GTK_TEXT_TOUCH_MODE_IDLE:
+    case GTK_TEXT_TOUCH_MODE_SELECTED:
+      switch (event)
+        {
+        case GTK_TEXT_TOUCH_EVENT_DOWN:
+          set_mode (self, GTK_TEXT_TOUCH_MODE_PENDING);
+          intent = GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          if (in_selection)
+            {
+              intent = GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES |
+                       GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE;
+            }
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:
+          intent = GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE;
+          set_mode (self, GTK_TEXT_TOUCH_MODE_SELECTED);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:
+          intent = GTK_TEXT_TOUCH_INTENT_CLEAR_SELECTION |
+                   GTK_TEXT_TOUCH_INTENT_HIDE_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_PLACE_CARET |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          set_mode (self, GTK_TEXT_TOUCH_MODE_IDLE);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:
+          intent = handle_pin_grabbed (self, pin);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_MOVED:
+        case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:
+        case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:
+        case GTK_TEXT_TOUCH_EVENT_UP:
+        case GTK_TEXT_TOUCH_EVENT_CANCEL:
+        case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:
+        case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:
+          break;
+        }
+      break;
+
+    case GTK_TEXT_TOUCH_MODE_PENDING:
+      switch (event)
+        {
+        case GTK_TEXT_TOUCH_EVENT_DOWN:
+          /* Idempotent: click + long-press begin both see DOWN. */
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:
+          /* Click on highlight after BEGIN already moved us to PENDING. */
+          intent = GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE;
+          set_mode (self, GTK_TEXT_TOUCH_MODE_SELECTED);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_MOVED:
+          set_mode (self, GTK_TEXT_TOUCH_MODE_CARET_DRAG);
+          intent = GTK_TEXT_TOUCH_INTENT_CLAIM |
+                   GTK_TEXT_TOUCH_INTENT_PLACE_CARET |
+                   GTK_TEXT_TOUCH_INTENT_MOVE_CARET |
+                   GTK_TEXT_TOUCH_INTENT_HIDE_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:
+          if (ctx->moved)
+            {
+              /* Hold fired after the finger already slid — caret-drag lane. */
+              set_mode (self, GTK_TEXT_TOUCH_MODE_CARET_DRAG);
+              intent = GTK_TEXT_TOUCH_INTENT_DENY |
+                       GTK_TEXT_TOUCH_INTENT_MOVE_CARET |
+                       GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+              break;
+            }
+          if (!on_text)
+            {
+              /* Past glyphs: abandon hold ownership so drag/motion can
+               * caret-follow (A15). Staying PENDING+claimed starved drag. */
+              set_mode (self, GTK_TEXT_TOUCH_MODE_CARET_DRAG);
+              intent = GTK_TEXT_TOUCH_INTENT_DENY |
+                       GTK_TEXT_TOUCH_INTENT_PLACE_CARET |
+                       GTK_TEXT_TOUCH_INTENT_MOVE_CARET |
+                       GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+              break;
+            }
+          set_mode (self, GTK_TEXT_TOUCH_MODE_SELECTING);
+          intent = GTK_TEXT_TOUCH_INTENT_CLAIM |
+                   GTK_TEXT_TOUCH_INTENT_SELECT_WORD |
+                   GTK_TEXT_TOUCH_INTENT_SHOW_MAGNIFIER |
+                   GTK_TEXT_TOUCH_INTENT_HIDE_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:
+          /* Contact continues; drag may promote to CARET_DRAG. */
+          intent = GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_UP:
+        case GTK_TEXT_TOUCH_EVENT_CANCEL:
+          if (in_selection || has_selection)
+            {
+              intent = GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES |
+                       GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE;
+              set_mode (self, GTK_TEXT_TOUCH_MODE_SELECTED);
+            }
+          else
+            {
+              intent = GTK_TEXT_TOUCH_INTENT_PLACE_CARET |
+                       GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+              set_mode (self, GTK_TEXT_TOUCH_MODE_IDLE);
+            }
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:
+          intent = handle_pin_grabbed (self, pin);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:
+        case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:
+        case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:
+          break;
+        }
+      break;
+
+    case GTK_TEXT_TOUCH_MODE_CARET_DRAG:
+      switch (event)
+        {
+        case GTK_TEXT_TOUCH_EVENT_MOVED:
+          intent = GTK_TEXT_TOUCH_INTENT_MOVE_CARET |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:
+          /* Mid-swipe hold must not flip into Selecting. */
+          intent = GTK_TEXT_TOUCH_INTENT_DENY;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_UP:
+        case GTK_TEXT_TOUCH_EVENT_CANCEL:
+          intent = GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          set_mode (self, GTK_TEXT_TOUCH_MODE_IDLE);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:
+          intent = handle_pin_grabbed (self, pin);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_DOWN:
+        case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:
+        case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:
+        case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:
+        case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:
+          break;
+        }
+      break;
+
+    case GTK_TEXT_TOUCH_MODE_SELECTING:
+      switch (event)
+        {
+        case GTK_TEXT_TOUCH_EVENT_MOVED:
+          intent = GTK_TEXT_TOUCH_INTENT_EXTEND_SELECTION |
+                   GTK_TEXT_TOUCH_INTENT_SHOW_MAGNIFIER |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:
+          /* Pin may have stolen the hold; keep SELECTING until UP/pin. */
+          intent = GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_UP:
+        case GTK_TEXT_TOUCH_EVENT_CANCEL:
+          intent = GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER |
+                   GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE;
+          set_mode (self, GTK_TEXT_TOUCH_MODE_SELECTED);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:
+          intent = handle_pin_grabbed (self, pin);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_DOWN:
+        case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:
+        case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:
+        case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:
+        case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:
+        case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:
+          break;
+        }
+      break;
+
+    case GTK_TEXT_TOUCH_MODE_PIN_CARET:
+      switch (event)
+        {
+        case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:
+        case GTK_TEXT_TOUCH_EVENT_MOVED:
+          intent = GTK_TEXT_TOUCH_INTENT_MOVE_CARET |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:
+        case GTK_TEXT_TOUCH_EVENT_UP:
+        case GTK_TEXT_TOUCH_EVENT_CANCEL:
+          intent = GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER;
+          set_mode (self, has_selection
+                    ? GTK_TEXT_TOUCH_MODE_SELECTED
+                    : GTK_TEXT_TOUCH_MODE_IDLE);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:
+          intent = GTK_TEXT_TOUCH_INTENT_DENY;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_DOWN:
+        case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:
+        case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:
+        case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:
+        case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:
+          break;
+        }
+      break;
+
+    case GTK_TEXT_TOUCH_MODE_PIN_SELECT:
+      switch (event)
+        {
+        case GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED:
+        case GTK_TEXT_TOUCH_EVENT_MOVED:
+          intent = GTK_TEXT_TOUCH_INTENT_EXTEND_SELECTION |
+                   GTK_TEXT_TOUCH_INTENT_SHOW_MAGNIFIER |
+                   GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE;
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_PIN_RELEASED:
+        case GTK_TEXT_TOUCH_EVENT_UP:
+        case GTK_TEXT_TOUCH_EVENT_CANCEL:
+          intent = GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER |
+                   GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES |
+                   GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE;
+          set_mode (self, GTK_TEXT_TOUCH_MODE_SELECTED);
+          break;
+
+        case GTK_TEXT_TOUCH_EVENT_DOWN:
+        case GTK_TEXT_TOUCH_EVENT_LONG_PRESS:
+        case GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED:
+        case GTK_TEXT_TOUCH_EVENT_PIN_GRABBED:
+        case GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION:
+        case GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE:
+          break;
+        }
+      break;
+
+    default:
+      break;
+    }
+
+  if (intent_out)
+    *intent_out = intent;
+
+  return TRUE;
+}
diff --git a/gtk/gtktexttouchprivate.h b/gtk/gtktexttouchprivate.h
new file mode 100644
index 0000000000..3feaf080f9
--- /dev/null
+++ b/gtk/gtktexttouchprivate.h
@@ -0,0 +1,151 @@
+/* GTK - The GIMP Toolkit
+ * Copyright © 2026 Knowles / LP-1 touch policy mock
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ *
+ * LP-1 touch mode machine — built as gtktexttouch.c (GtkText + GtkTextView).
+ * Pattern: private helper like GtkTextHistory / GtkTextHandle — widgets own
+ * one instance; gestures feed events; widgets apply returned intents.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/**
+ * GtkTextTouchMode:
+ * @GTK_TEXT_TOUCH_MODE_IDLE: no active touch sequence for this machine
+ * @GTK_TEXT_TOUCH_MODE_PENDING: finger down; not yet CaretDrag or Selecting
+ * @GTK_TEXT_TOUCH_MODE_CARET_DRAG: short touch drag → move caret only
+ * @GTK_TEXT_TOUCH_MODE_SELECTING: hold (or hold+drag) → growing selection
+ * @GTK_TEXT_TOUCH_MODE_SELECTED: sequence ended with a selection still active
+ * @GTK_TEXT_TOUCH_MODE_PIN_CARET: cursor pin owns the contact
+ * @GTK_TEXT_TOUCH_MODE_PIN_SELECT: selection pin owns the contact
+ *
+ * Mouse / trackpad sequences never enter this machine — widgets keep the
+ * classic click/drag-select path for those devices.
+ */
+typedef enum
+{
+  GTK_TEXT_TOUCH_MODE_IDLE,
+  GTK_TEXT_TOUCH_MODE_PENDING,
+  GTK_TEXT_TOUCH_MODE_CARET_DRAG,
+  GTK_TEXT_TOUCH_MODE_SELECTING,
+  GTK_TEXT_TOUCH_MODE_SELECTED,
+  GTK_TEXT_TOUCH_MODE_PIN_CARET,
+  GTK_TEXT_TOUCH_MODE_PIN_SELECT,
+} GtkTextTouchMode;
+
+/**
+ * GtkTextTouchEvent:
+ *
+ * Facts reported by gesture controllers. They do not encode policy.
+ */
+typedef enum
+{
+  GTK_TEXT_TOUCH_EVENT_DOWN,
+  GTK_TEXT_TOUCH_EVENT_MOVED,           /* past drag threshold */
+  GTK_TEXT_TOUCH_EVENT_LONG_PRESS,
+  /* Hold gesture cancelled; finger may still be down (drag continues). */
+  GTK_TEXT_TOUCH_EVENT_HOLD_CANCELLED,
+  GTK_TEXT_TOUCH_EVENT_UP,
+  GTK_TEXT_TOUCH_EVENT_CANCEL,          /* whole sequence aborted */
+  GTK_TEXT_TOUCH_EVENT_PIN_GRABBED,     /* cursor or selection pin claimed */
+  GTK_TEXT_TOUCH_EVENT_PIN_DRAGGED,
+  GTK_TEXT_TOUCH_EVENT_PIN_RELEASED,
+  GTK_TEXT_TOUCH_EVENT_TAP_IN_SELECTION,
+  GTK_TEXT_TOUCH_EVENT_TAP_OUTSIDE,     /* clear / dismiss path */
+} GtkTextTouchEvent;
+
+/**
+ * GtkTextTouchPinKind:
+ */
+typedef enum
+{
+  GTK_TEXT_TOUCH_PIN_NONE,
+  GTK_TEXT_TOUCH_PIN_CURSOR,
+  GTK_TEXT_TOUCH_PIN_SELECTION_START,
+  GTK_TEXT_TOUCH_PIN_SELECTION_END,
+} GtkTextTouchPinKind;
+
+/**
+ * GtkTextTouchIntent:
+ *
+ * Bitmask of actions the widget should perform. The machine never touches
+ * the buffer, handles, or bubble itself.
+ */
+typedef enum
+{
+  GTK_TEXT_TOUCH_INTENT_NONE              = 0,
+  GTK_TEXT_TOUCH_INTENT_CLAIM             = 1 << 0,
+  GTK_TEXT_TOUCH_INTENT_DENY              = 1 << 1,
+  GTK_TEXT_TOUCH_INTENT_PLACE_CARET       = 1 << 2,
+  GTK_TEXT_TOUCH_INTENT_MOVE_CARET        = 1 << 3,
+  GTK_TEXT_TOUCH_INTENT_SELECT_WORD       = 1 << 4,
+  GTK_TEXT_TOUCH_INTENT_EXTEND_SELECTION  = 1 << 5,
+  GTK_TEXT_TOUCH_INTENT_CLEAR_SELECTION   = 1 << 6,
+  GTK_TEXT_TOUCH_INTENT_SHOW_HANDLES      = 1 << 7,
+  GTK_TEXT_TOUCH_INTENT_HIDE_HANDLES      = 1 << 8,
+  GTK_TEXT_TOUCH_INTENT_SHOW_MAGNIFIER    = 1 << 9,
+  GTK_TEXT_TOUCH_INTENT_HIDE_MAGNIFIER    = 1 << 10,
+  GTK_TEXT_TOUCH_INTENT_ALLOW_BUBBLE      = 1 << 11, /* copy/paste bar may show */
+  GTK_TEXT_TOUCH_INTENT_SUPPRESS_BUBBLE   = 1 << 12,
+} GtkTextTouchIntent;
+
+/**
+ * GtkTextTouchContext:
+ *
+ * Hit-test / selection facts supplied by the widget for one transition.
+ */
+typedef struct
+{
+  gboolean on_text;
+  gboolean in_selection;
+  gboolean has_selection;
+  /* TRUE if this contact already moved past the drag threshold. */
+  gboolean moved;
+  GtkTextTouchPinKind pin;
+} GtkTextTouchContext;
+
+typedef struct _GtkTextTouch GtkTextTouch;
+
+GtkTextTouch *       gtk_text_touch_new            (void);
+void                 gtk_text_touch_free           (GtkTextTouch *self);
+
+GtkTextTouchMode     gtk_text_touch_get_mode       (GtkTextTouch *self);
+
+/**
+ * gtk_text_touch_handle:
+ * @self: touch policy for one text widget
+ * @event: gesture fact
+ * @ctx: (nullable): hit-test facts for this event; ignored when unused
+ * @intent_out: (out): actions for the widget to apply
+ *
+ * Returns: %TRUE if this machine consumed the event (touch lane).
+ * %FALSE means “not our lane” — widget should use classic mouse policy.
+ *
+ * Call only for sequences where gtk_event_treat_as_touch() was true at DOWN
+ * (or for pin events that are inherently touch). Do not flip lanes mid-sequence.
+ */
+gboolean             gtk_text_touch_handle         (GtkTextTouch              *self,
+                                                    GtkTextTouchEvent          event,
+                                                    const GtkTextTouchContext *ctx,
+                                                    GtkTextTouchIntent        *intent_out);
+
+const char *         gtk_text_touch_mode_nick      (GtkTextTouchMode mode);
+const char *         gtk_text_touch_event_nick     (GtkTextTouchEvent event);
+
+G_END_DECLS
