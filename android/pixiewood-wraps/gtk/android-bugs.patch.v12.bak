+	private void syncEditableFromGtk(Editable content, SurroundingRetVal surrounding) {
+		if (surrounding == null || content == null)
+			return;
+
+		content.replace(0, content.length(), surrounding.text != null ? surrounding.text : "");
+		String text = content.toString();
+		int cursor = codePointIndexToUtf16(text, surrounding.cursor_index);
+		int anchor = codePointIndexToUtf16(text, surrounding.anchor_index);
+		Selection.setSelection(content, anchor, cursor);
+	}
+
+	/** Convert a Unicode code-point index to a UTF-16 offset into {@code text}. */
+	private static int codePointIndexToUtf16(String text, int codePointIndex) {
+		if (text == null || text.isEmpty() || codePointIndex <= 0)
+			return 0;
+		int cpCount = text.codePointCount(0, text.length());
+		if (codePointIndex >= cpCount)
+			return text.length();
+		return text.offsetByCodePoints(0, codePointIndex);
+	}
+
+	private void applyGtkSnapshot(ImeConnection conn, SurroundingRetVal surrounding, int serial) {
+		if (serial != gtkSyncSerial || activeConnection != conn)
+			return;
+		Editable ed = conn.getEditable();
+		if (ed == null || surrounding == null)
+			return;
+
+		String gtk = surrounding.text != null ? surrounding.text : "";
+		int wantCursor = codePointIndexToUtf16(gtk, surrounding.cursor_index);
+		int wantAnchor = codePointIndexToUtf16(gtk, surrounding.anchor_index);
+		int selStart = Selection.getSelectionStart(ed);
+		int selEnd = Selection.getSelectionEnd(ed);
+		boolean textSame = gtk.equals(ed.toString());
+		boolean selSame =
+				(selStart == wantAnchor && selEnd == wantCursor)
+				|| (selStart == wantCursor && selEnd == wantAnchor);
+
+		int compStart = BaseInputConnection.getComposingSpanStart(ed);
+		int compEnd = BaseInputConnection.getComposingSpanEnd(ed);
+		if (compStart != -1 && textSame
+				&& (wantCursor < compStart || wantCursor > compEnd
+				|| wantAnchor < compStart || wantAnchor > compEnd)) {
+			BaseInputConnection.removeComposingSpans(ed);
+			compStart = -1;
+		}
+
+		if (compStart != -1 && !textSame)
+			return;
+
+		if (textSame && selSame)
+			return;
+
+		if (textSame)
+			Selection.setSelection(ed, wantAnchor, wantCursor);
+		else
+			syncEditableFromGtk(ed, surrounding);
+
+		View view = conn.targetView;
+		InputMethodManager imm = view.getContext().getSystemService(InputMethodManager.class);
+		int start = Selection.getSelectionStart(ed);
+		int end = Selection.getSelectionEnd(ed);
+		imm.updateSelection(view, start, end,
+				BaseInputConnection.getComposingSpanStart(ed),
+				BaseInputConnection.getComposingSpanEnd(ed));
+	}
+
+	/**
+	 * Called from native (GTK thread via JNI) when the client buffer/selection
+	 * changed outside an IME→GTK push. Snapshot surrounding on this thread so
+	 * the UI apply is not one caret move behind.
+	 */
+	@Keep
+	public void notifyGtkTextChanged() {
+		final ImeConnection conn = activeConnection;
+		if (conn == null)
+			return;
+
+		final SurroundingRetVal snap = getSurrounding();
+		if (snap == null)
+			return;
+
+		final int serial = ++gtkSyncSerial;
+		final View view = conn.targetView;
+		view.post(() -> applyGtkSnapshot(conn, snap, serial));
+	}
+
+	/** Replace GTK surrounding with {@code text} via delete-all + commit (cursor ends at end). */
+	private void gtkReplaceAll(String text) {
+		updatePreedit(null, 0);
+		SurroundingRetVal s = getSurrounding();
+		if (s != null && s.text != null && s.text.length() > 0) {
+			if (s.cursor_index != s.anchor_index) {
+				int a = Math.min(s.cursor_index, s.anchor_index);
+				int b = Math.max(s.cursor_index, s.anchor_index);
+				int n = b - a;
+				if (s.cursor_index >= s.anchor_index)
+					deleteSurrounding(-n, n);
+				else
+					deleteSurrounding(0, n);
+				s = getSurrounding();
+			}
+			if (s != null && s.text != null && s.text.length() > 0) {
+				int left = s.cursor_index;
+				int right = s.text.length() - s.cursor_index;
+				if (left > 0)
+					deleteSurrounding(-left, left);
+				if (right > 0)
+					deleteSurrounding(0, right);
+			}
+		}
+		if (text != null && text.length() > 0)
+			commit(text);
+	}
+
+	/**
+	 * Push Editable → GTK. Prefer a prefix/suffix diff so mid-field autocorrect does not
+	 * jump the GTK cursor to the end of the whole buffer. After a real text change, place
+	 * the GTK cursor where the Editable left it (Gboard: after the replaced word + space).
+	 * Do not push selection when text is unchanged — that fights long-press highlighting.
+	 */
+	private void pushEditableToGtk(Editable content) {
+		if (content == null)
+			return;
+
+		final String neu = content.toString();
+		final int utf16Cursor = Selection.getSelectionEnd(content);
+		final int utf16Anchor = Selection.getSelectionStart(content);
+		GlibContext.blockForMain(() -> {
+			updatePreedit(null, 0);
+			SurroundingRetVal s = getSurrounding();
+			String alt = (s != null && s.text != null) ? s.text : "";
+			if (alt.equals(neu))
+				return;
+
+			int prefix = 0;
+			int maxPrefix = Math.min(alt.length(), neu.length());
+			while (prefix < maxPrefix && alt.charAt(prefix) == neu.charAt(prefix))
+				prefix++;
