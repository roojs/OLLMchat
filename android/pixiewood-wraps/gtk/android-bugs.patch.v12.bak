+  root = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+  if (root == NULL)
+    return;
+
+  graphene_point_init (&pt, x, y);
+
+  /* Pins use empty input, so pick often returns Nested Dialog underneath.
+   * Skip dismiss when the press is on/near a drawn pin. */
+  for (i = 0; i < TEXT_HANDLE_N_HANDLES; i++)
+    {
+      GtkWidget *hw;
+      graphene_rect_t hr;
+
+      if (priv->text_handles[i] == NULL)
+        continue;
+      hw = GTK_WIDGET (priv->text_handles[i]);
+      if (!gtk_widget_get_visible (hw))
+        continue;
+      if (!gtk_widget_compute_bounds (hw, root, &hr))
+        continue;
+      hr.origin.x -= 40;
+      hr.origin.y -= 10;
+      hr.size.width += 80;
+      hr.size.height += 60;
+      if (graphene_rect_contains_point (&hr, &pt))
+        return;
+    }
+
+  /* Top field is a short strip; a slightly-low tap often picks Nested Dialog
+   * under the pins and was treated as outside-field (A9). Only skip dismiss
+   * when the pick is that under-widget *and* the point is near the field —
+   * do not treat empty chrome / true outside as near-field. */
+  {
+    graphene_rect_t field_r;
+
+    picked = gtk_widget_pick (root, x, y, GTK_PICK_DEFAULT);
+    if (picked != NULL &&
+        (picked == GTK_WIDGET (self) ||
+         gtk_widget_is_ancestor (picked, GTK_WIDGET (self)) ||
+         picked == priv->selection_bubble ||
+         gtk_widget_is_ancestor (picked, priv->selection_bubble)))
+      return;
+
+    if (picked != NULL &&
+        picked != root &&
+        !GTK_IS_TEXT (picked) &&
+        gtk_widget_compute_bounds (GTK_WIDGET (self), root, &field_r))
+      {
+        field_r.origin.x -= 8;
+        field_r.origin.y -= 4;
+        field_r.size.width += 16;
+        field_r.size.height += 40;
+        if (graphene_rect_contains_point (&field_r, &pt))
+          {
+            g_message ("CLIP: outside-field skip near-field pick=%s",
+                       G_OBJECT_TYPE_NAME (picked));
+            return;
+          }
+      }
+  }
+
+  gtk_text_selection_bubble_popup_unset (self, "outside-field");
+}
+
+static void
+gtk_text_ensure_outside_bar_dismiss (GtkText *self)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+  GtkRoot *root;
+  GtkGesture *gesture;
+
+  if (priv->outside_bar_dismiss != NULL)
+    return;
+
+  root = gtk_widget_get_root (GTK_WIDGET (self));
+  if (root == NULL)
+    return;
+
+  gesture = gtk_gesture_click_new ();
+  gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (gesture), GDK_BUTTON_PRIMARY);
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (gesture),
+                                              GTK_PHASE_CAPTURE);
+  g_signal_connect (gesture, "pressed",
+                    G_CALLBACK (gtk_text_outside_bar_dismiss_pressed), self);
+  gtk_widget_add_controller (GTK_WIDGET (root), GTK_EVENT_CONTROLLER (gesture));
+  priv->outside_bar_dismiss = GTK_EVENT_CONTROLLER (gesture);
+}
+
+static void
+gtk_text_selection_bubble_popup_unset (GtkText *self,
+                                       const char *reason)
+{
+  GtkTextPrivate *priv = gtk_text_get_instance_private (self);
+
+  g_message ("CLIP: bubble hide reason=%s widget=GtkText",
+             reason != NULL ? reason : "?");
 
   if (priv->selection_bubble)
     gtk_widget_set_visible (priv->selection_bubble, FALSE);
@@ -6597,10 +7934,14 @@ gtk_text_selection_bubble_popup_unset (GtkText *self)
 }
 
 static void
-gtk_text_selection_bubble_popup_set (GtkText *self)
+gtk_text_selection_bubble_popup_set (GtkText *self,
+                                     const char *reason)
 {
   GtkTextPrivate *priv = gtk_text_get_instance_private (self);
 
+  g_message ("CLIP: bubble show reason=%s widget=GtkText",
+             reason != NULL ? reason : "?");
+
   if (priv->selection_bubble_timeout_id)
     g_source_remove (priv->selection_bubble_timeout_id);
 
