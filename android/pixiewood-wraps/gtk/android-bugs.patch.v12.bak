+      GtkTextTouchIntent intent = GTK_TEXT_TOUCH_INTENT_NONE;
+
+      layout = gtk_text_ensure_layout (self, TRUE);
+      pango_layout_get_pixel_size (layout, &text_width, NULL);
+      tmp_pos = gtk_text_find_position (self, layout_x);
