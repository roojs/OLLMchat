+                             &tctx, &intent);
+
+      if (intent & GTK_TEXT_TOUCH_INTENT_DENY)
+        {
+          gtk_text_set_positions (self, tmp_pos, tmp_pos);
+          g_message ("CLIP: longpress GtkText OUTSIDE-GLYPHS layout_x=%d "
+                     "text_width=%d → cursor-only mode=%s",
+                     layout_x, text_width,
+                     gtk_text_touch_mode_nick (gtk_text_touch_get_mode (priv->touch)));
+          gtk_text_touch_apply_chrome (self, intent,
+                                       layout_x - priv->scroll_offset, (int) y,
+                                       NULL);
+          /* Drop BEGIN claim so grouped drag can caret-follow. */
+          gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_DENIED);
+        }
+      else if (intent & GTK_TEXT_TOUCH_INTENT_SELECT_WORD)
+        {
+          gtk_text_set_positions (self, tmp_pos, tmp_pos);
+          gtk_text_select_word (self);
+          /* Hold-select is not a multipress chain. */
+          priv->touch_press_count = 0;
+          priv->touch_last_press_time = 0;
+          g_message ("CLIP: longpress GtkText SELECT pos=%d bound=%d layout_x=%d",
+                     priv->current_pos, priv->selection_bound, layout_x);
+          gtk_text_touch_apply_chrome (self, intent,
+                                       layout_x - priv->scroll_offset, (int) y,
+                                       NULL);
+        }
+
+      if (intent & GTK_TEXT_TOUCH_INTENT_CLAIM)
+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+    }
