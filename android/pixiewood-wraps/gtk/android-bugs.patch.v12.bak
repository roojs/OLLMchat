+
+    gtk_text_buffer_get_end_iter (buffer, &end_iter);
+    gtk_text_view_get_iter_location (text_view, &end_iter, &end_rect);
+    last_bottom = end_rect.y + end_rect.height;
+
+    other_row =
+      (hit_rect.y + hit_rect.height <= old_rect.y) ||
+      (hit_rect.y >= old_rect.y + old_rect.height);
+    past_glyph = ax > hit_rect.x + hit_rect.width;
+    below_old_box = ay >= old_rect.y + old_rect.height;
+    below_last = ay >= last_bottom;
+    end_clamp_left = (hit_rect.width == 0 && ax < hit_rect.x);
+
+    off_stock = gtk_text_iter_get_offset (&stock_iter);
+
+    /* L: other row + past landed glyph → current mid_y */
+    cand = stock_iter;
+    if (other_row && past_glyph)
+      gtk_text_layout_get_iter_at_pixel (priv->layout, &cand, ax, old_mid);
+    off_L = gtk_text_iter_get_offset (&cand);
+
+    /* M: tip below caret glyph box → resolve X on current mid_y */
+    cand = stock_iter;
+    if (below_old_box)
+      gtk_text_layout_get_iter_at_pixel (priv->layout, &cand, ax, old_mid);
+    else if (other_row && past_glyph)
+      gtk_text_layout_get_iter_at_pixel (priv->layout, &cand, ax, old_mid);
+    off_M = gtk_text_iter_get_offset (&cand);
+
+    /* N (APPLY): tip below last laid-out row → current mid_y; else L.
