@@ -35,6 +35,15 @@ typedef struct _GdkAndroidClipboard
 
   GCancellable *cancellable;
 
+  /*
+   * Android ClipboardManager is the source of truth (no X11-style ownership).
+   * While commit_in_progress, we still hold a temporary local GdkContentProvider
+   * so paste works during async serialize→setPrimaryClip; notifications must not
+   * adopt the system clip until that commit finishes (or is superseded).
+   */
+  gboolean commit_in_progress;
+  guint commit_serial;
+
   jobject manager;
   jobject listener;
