+		public boolean replaceText(int start, int end, CharSequence text, int newCursorPosition,
+				@Nullable TextAttribute textAttribute) {
+			return runThenPushToGtk(() -> super.replaceText(start, end, text, newCursorPosition, textAttribute));
+		}
+
+		@Override
+		public boolean performContextMenuAction(int id) {
+			boolean ok = super.performContextMenuAction(id);
+			if (id == android.R.id.paste || id == android.R.id.pasteAsPlainText)
+				pushEditableToGtk(getEditable());
+			return ok;
+		}
+
+		private boolean deleteSelectionIfAny() {
+			Editable ed = getEditable();
+			if (ed != null) {
+				int a = Selection.getSelectionStart(ed);
+				int b = Selection.getSelectionEnd(ed);
+				if (a >= 0 && b >= 0 && a != b) {
+					ed.delete(Math.min(a, b), Math.max(a, b));
+					pushEditableToGtk(ed);
+					return true;
+				}
+			}
+
+			SurroundingRetVal s = GlibContext.blockForMain(ImContext.this::getSurrounding);
+			if (s == null || s.text == null || s.cursor_index == s.anchor_index)
+				return false;
+
+			int start = Math.min(s.cursor_index, s.anchor_index);
+			int end = Math.max(s.cursor_index, s.anchor_index);
+			if (ed != null) {
+				int len = ed.length();
+				start = Math.min(Math.max(start, 0), len);
+				end = Math.min(Math.max(end, 0), len);
+				if (start < end) {
+					Selection.setSelection(ed, start, end);
+					ed.delete(start, end);
+					pushEditableToGtk(ed);
+					return true;
+				}
+			}
+
+			GlibContext.blockForMain(() -> {
+				SurroundingRetVal cur = ImContext.this.getSurrounding();
+				if (cur == null || cur.cursor_index == cur.anchor_index)
+					return;
+				int a = Math.min(cur.cursor_index, cur.anchor_index);
+				int b = Math.max(cur.cursor_index, cur.anchor_index);
+				int n = b - a;
+				if (cur.cursor_index >= cur.anchor_index)
+					ImContext.this.deleteSurrounding(-n, n);
+				else
+					ImContext.this.deleteSurrounding(0, n);
+			});
+			if (ed != null)
+				syncEditableFromGtk(ed, GlibContext.blockForMain(ImContext.this::getSurrounding));
 			return true;
 		}
 
 		@Override
 		public boolean deleteSurroundingText(int leftLength, int rightLength) {
-			logger.info("IME: deleteSurroundingText(" + leftLength + ", " + rightLength + ")");
+			if (deleteSelectionIfAny())
+				return true;
+			return runThenPushToGtk(() -> super.deleteSurroundingText(leftLength, rightLength));
+		}
+
+		@Override
+		public boolean deleteSurroundingTextInCodePoints(int beforeLength, int afterLength) {
+			if (deleteSelectionIfAny())
+				return true;
+			return runThenPushToGtk(() -> super.deleteSurroundingTextInCodePoints(beforeLength, afterLength));
+		}
 
-			// The stock Samsung keyboard with 'Auto check spelling' enabled sends leftLength > 1.
-			KeyEvent deleteKey = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_DEL);
-			for (int i = 0; i < leftLength; i++) sendKeyEvent(deleteKey);
-			return super.deleteSurroundingText(leftLength, rightLength);
+		@Override
+		public boolean sendKeyEvent(KeyEvent event) {
+			if (event.getKeyCode() != KeyEvent.KEYCODE_DEL)
+				return super.sendKeyEvent(event);
+			if (event.getAction() != KeyEvent.ACTION_DOWN && event.getAction() != KeyEvent.ACTION_MULTIPLE)
+				return super.sendKeyEvent(event);
+
+			if (deleteSelectionIfAny())
+				return true;
+
+			int count = event.getRepeatCount() > 0 ? event.getRepeatCount() : 1;
+			for (int i = 0; i < count; i++)
+				super.deleteSurroundingText(1, 0);
+			pushEditableToGtk(getEditable());
+			return true;
 		}
 	}
 }
