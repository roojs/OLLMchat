+
+static void
+handle_clear_foreign_press (GtkTextHandle *handle,
+                            double         x,
+                            double         y)
+{
+  GtkWidget *picked;
+  GtkWidget *w;
+  GtkWidget *owner;
+
+  if (handle->controller_widget == NULL)
+    return;
+
+  owner = gtk_widget_get_parent (GTK_WIDGET (handle));
+  picked = gtk_widget_pick (handle->controller_widget, x, y, GTK_PICK_DEFAULT);
+  for (w = picked; w != NULL && w != handle->controller_widget;
+       w = gtk_widget_get_parent (w))
+    {
+      GListModel *controllers;
+      guint i, n;
+      gboolean on_owner_chain;
+
+      /* Text field + its ancestors: leave their gestures alone. */
+      on_owner_chain = (owner != NULL &&
+                        (w == owner || gtk_widget_is_ancestor (owner, w)));
+      if (on_owner_chain)
+        continue;
+
+      gtk_widget_unset_state_flags (w, GTK_STATE_FLAG_ACTIVE |
+                                    GTK_STATE_FLAG_PRELIGHT |
+                                    GTK_STATE_FLAG_DROP_ACTIVE);
+      gtk_widget_remove_css_class (w, "pressed");
+
+      controllers = gtk_widget_observe_controllers (w);
+      n = g_list_model_get_n_items (controllers);
+      for (i = 0; i < n; i++)
+        {
+          GtkEventController *c = g_list_model_get_item (controllers, i);
+
+          if (c != handle->controller && GTK_IS_GESTURE (c))
+            {
+              /* DENY often no-ops if the gesture has not seen this sequence
+               * yet (GTK docs). Reset clears button_down / :active. */
+              gtk_event_controller_reset (c);
+            }
+          g_object_unref (c);
+        }
+      g_object_unref (controllers);
+
+      /* Pin is input-transparent; stop the widget under it eating the rest
+       * of the contact (Nested Dialog looking pressed while the pin moves). */
+      if (gtk_widget_get_can_target (w))
+        {
+          gtk_widget_set_can_target (w, FALSE);
+          if (g_slist_find (handle->suppress_can_target, w) == NULL)
+            handle->suppress_can_target =
+              g_slist_prepend (handle->suppress_can_target, w);
+        }
+    }
+}
+
+static gboolean
+handle_clear_foreign_press_idle (gpointer data)
+{
+  GtkTextHandle *handle = data;
+  GSList *l;
+
+  if (!handle->dragged)
+    {
+      g_object_unref (handle);
+      return G_SOURCE_REMOVE;
+    }
+
+  for (l = handle->suppress_can_target; l != NULL; l = l->next)
+    {
+      GtkWidget *w = l->data;
+
+      if (!GTK_IS_WIDGET (w))
+        continue;
+      gtk_widget_unset_state_flags (w, GTK_STATE_FLAG_ACTIVE |
+                                    GTK_STATE_FLAG_PRELIGHT |
+                                    GTK_STATE_FLAG_DROP_ACTIVE);
+      gtk_widget_remove_css_class (w, "pressed");
+    }
+
+  g_object_unref (handle);
+  return G_SOURCE_REMOVE;
+}
