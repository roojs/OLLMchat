   gsize width_subsample, height_subsample, bpp;
+  gsize image_w, image_h;
+  gboolean is_shared_subupload;
+  GdkGLContext *saved_context = NULL;
+
+  image_w = gsk_gpu_image_get_width (image);
+  image_h = gsk_gpu_image_get_height (image);
+
+  /* Glyph/fill/stroke atlas textures live on the display-wide GskGLDevice and
+   * are shared across per-surface GL contexts. Sub-rectangle uploads into those
+   * images must run with the display context current — uploading from a popup
+   * surface context has crashed Adreno inside glTexSubImage2D (fault 0x10). */
+  is_shared_subupload = (area->x != 0 || area->y != 0 ||
+                         (gsize) area->width != image_w ||
+                         (gsize) area->height != image_h);
+  if (is_shared_subupload)
+    {
+      saved_context = gdk_gl_context_get_current ();
