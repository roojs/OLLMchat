 static void
-gtk_text_view_selection_bubble_popup_unset (GtkTextView *text_view)
+gtk_text_view_outside_bar_dismiss_pressed (GtkGestureClick *gesture,
+                                           int              n_press,
+                                           double           x,
+                                           double           y,
+                                           GtkTextView     *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GtkWidget *root;
+  GtkWidget *picked;
+  graphene_point_t pt;
+  int i;
+
+  if (n_press != 1)
+    return;
+  if (priv->selection_bubble == NULL ||
+      !gtk_widget_get_visible (priv->selection_bubble))
+    return;
+
+  root = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+  if (root == NULL)
+    return;
+
+  graphene_point_init (&pt, x, y);
+
+  for (i = 0; i < TEXT_HANDLE_N_HANDLES; i++)
+    {
+      GtkWidget *hw;
+      graphene_rect_t hr;
+
+      if (priv->text_handles[i] == NULL)
+        continue;
+      hw = GTK_WIDGET (priv->text_handles[i]);
+      if (!gtk_widget_get_visible (hw))
+        continue;
+      if (!gtk_widget_compute_bounds (hw, root, &hr))
+        continue;
+      hr.origin.x -= 40;
+      hr.origin.y -= 10;
+      hr.size.width += 80;
+      hr.size.height += 60;
+      if (graphene_rect_contains_point (&hr, &pt))
+        return;
+    }
+
+  picked = gtk_widget_pick (root, x, y, GTK_PICK_DEFAULT);
+  if (picked != NULL &&
+      (picked == GTK_WIDGET (text_view) ||
+       gtk_widget_is_ancestor (picked, GTK_WIDGET (text_view)) ||
+       picked == priv->selection_bubble ||
+       gtk_widget_is_ancestor (picked, priv->selection_bubble)))
+    return;
+
+  gtk_text_view_selection_bubble_popup_unset (text_view, "outside-field");
+}
+
+static void
+gtk_text_view_ensure_outside_bar_dismiss (GtkTextView *text_view)
+{
+  GtkTextViewPrivate *priv = text_view->priv;
+  GtkRoot *root;
+  GtkGesture *gesture;
+
+  if (priv->outside_bar_dismiss != NULL)
+    return;
+
+  root = gtk_widget_get_root (GTK_WIDGET (text_view));
+  if (root == NULL)
+    return;
+
+  gesture = gtk_gesture_click_new ();
+  gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (gesture), GDK_BUTTON_PRIMARY);
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (gesture),
+                                              GTK_PHASE_CAPTURE);
+  g_signal_connect (gesture, "pressed",
+                    G_CALLBACK (gtk_text_view_outside_bar_dismiss_pressed),
+                    text_view);
+  gtk_widget_add_controller (GTK_WIDGET (root), GTK_EVENT_CONTROLLER (gesture));
+  priv->outside_bar_dismiss = GTK_EVENT_CONTROLLER (gesture);
+}
+
+static void
+gtk_text_view_selection_bubble_popup_unset (GtkTextView *text_view,
+                                            const char  *reason)
 {
   GtkTextViewPrivate *priv;
 
   priv = text_view->priv;
 
+  g_message ("CLIP: bubble hide reason=%s widget=TextView",
+             reason != NULL ? reason : "?");
+
   if (priv->selection_bubble)
     gtk_widget_set_visible (priv->selection_bubble, FALSE);
 
