[binaries]
# Host glib-mkenums 2.84 does not parse G_GNUC_FLAG_ENUM (GLib 2.86+).
# Use the wrap's 2.90 script so libadwaita does not need a source patch.
glib-mkenums = ['python3', '../subprojects/glib/gobject/glib-mkenums.in']

[json-glib:project options]
introspection = 'disabled'
documentation = 'disabled'

[libsoup:project options]
tests = false
introspection = 'disabled'
docs = 'disabled'
brotli = 'disabled'
gssapi = 'disabled'
ntlm = 'disabled'
# Cross builds cannot run libsoup's GIO TLS compile-time probe; runtime TLS
# comes from glib-networking (see ollmapp/android/android-gio-tls.c).
tls_check = false
sysprof = 'disabled'

[glib-networking:project options]
default_library = 'static'
gnutls = 'disabled'
openssl = 'enabled'
libproxy = 'disabled'
gnome_proxy = 'disabled'
environment_proxy = 'enabled'
installed_tests = false

[libollmchat:project options]
docs = false
examples = false
tests = false
local_gguf = 'disabled'
android_poc = true

[ollmchat:project options]
docs = false
examples = false
tests = false
local_gguf = 'disabled'
android_poc = true
